{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setta.dev/schema/setta.plugin.schema.json",
  "title": "Setta Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "settaVersionRange": {
      "type": "string"
    },
    "enabledByDefault": {
      "type": "boolean"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageManager"],
          "properties": {
            "packageManager": {
              "type": "string",
              "enum": ["pnpm"]
            }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blueprintsDir": { "type": "string", "minLength": 1 },
        "projectTemplatesDir": { "type": "string", "minLength": 1 },
        "promptsDir": { "type": "string", "minLength": 1 }
      }
    },
    "configSchemaPath": {
      "type": "string",
      "minLength": 1
    },
    "featureCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appSubsystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "appAuthoringUi": { "type": "boolean" },
            "appPreviewUi": { "type": "boolean" },
            "appGenerationChatModes": { "type": "boolean" },
            "appDeploymentRuntime": { "type": "boolean" }
          }
        },
        "watchCode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": { "type": "boolean" },
            "requiresLanguageServer": { "type": "boolean" },
            "canvasControlsUi": { "type": "boolean" }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "registerSectionKinds",
          "registerPane",
          "registerSettingRevealHandler",
          "registerCommand",
          "registerTopNavBarItem",
          "registerCanvasControl",
          "registerContextMenu",
          "readProjectState",
          "subscribeProjectState",
          "emitListenerEvents",
          "registerMcpTools",
          "registerLanguageServer",
          "registerExternalAgentAdapter",
          "registerCodegenTarget",
          "registerRouter",
          "registerListenerEndpoint",
          "registerStaticDir",
          "registerAppSubsystemBackend",
          "mutateWatchCodeSettings",
          "writeWorkspacePlugins"
        ]
      },
      "uniqueItems": true
    }
  }
}
