{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setta.dev/schema/setta.plugin.schema.json",
  "title": "Setta Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "settaVersionRange": {
      "type": "string"
    },
    "enabledByDefault": {
      "type": "boolean"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blueprintsDir": { "type": "string", "minLength": 1 },
        "projectTemplatesDir": { "type": "string", "minLength": 1 },
        "promptsDir": { "type": "string", "minLength": 1 }
      }
    },
    "configSchemaPath": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "registerSectionKinds",
          "registerPane",
          "registerCommand",
          "registerTopNavBarItem",
          "registerContextMenu",
          "readProjectState",
          "subscribeProjectState",
          "emitListenerEvents",
          "registerLanguageServer",
          "registerCodegenTarget",
          "registerListenerEndpoint",
          "registerStaticDir",
          "writeWorkspacePlugins"
        ]
      },
      "uniqueItems": true
    }
  }
}
