{
  "name": "abcde",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "nodemon src/server.ts",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "db/runTests.bat",
    "test:watch": "yarn test --watch",
    "test:cov": "yarn test --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "yarn test --config ./test/jest-e2e.json",
    "f": "yarn prettier src test prisma --write",
    "linkutils": "cd ../abcde-utils && git pull && yarn && yarn link && cd ../abcde-backend && yarn link abcde-utils",
    "linktest": "cd ../abcde-test && git pull && yarn && yarn link && cd ../abcde-backend && yarn link abcde-test"
  },
  "dependencies": {
    "@prisma/client": "4.5.0",
    "cors": "2.8.5",
    "express": "4.18.2",
    "express-async-errors": "3.1.1",
    "express-session": "1.17.3",
    "lodash": "4.17.21",
    "passport": "0.6.0",
    "passport-local": "1.0.0"
  },
  "devDependencies": {
    "@types/jest": "28.1.4",
    "@types/lodash": "4.14.191",
    "@types/node": "16.0.0",
    "@types/supertest": "2.0.11",
    "@typescript-eslint/eslint-plugin": "5.0.0",
    "@typescript-eslint/parser": "5.0.0",
    "dotenv-cli": "^6.0.0",
    "eslint": "8.0.1",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-prettier": "4.0.0",
    "jest": "28.1.2",
    "nodemon": "2.0.20",
    "prettier": "2.7.1",
    "prettier-plugin-organize-imports": "3.1.1",
    "prisma": "4.5.0",
    "supertest": "6.1.3",
    "ts-jest": "28.0.5",
    "ts-loader": "9.2.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.1.0",
    "typescript": "4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "modulePaths": [
      "<rootDir>"
    ]
  },
  "prisma": {
    "seed": "node_modules/.bin/ts-node --esm prisma/seed.ts"
  }
}
