generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CodeInfo {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @db.VarChar(255)
  version     String?    @db.VarChar(255)
  defaultVal  String?    @db.VarChar(255)
  type        String     @db.VarChar(255)
  rcType      String     @db.VarChar(255)
  description String?    @db.VarChar(255)
  path        String?    @db.VarChar(255)
  children    CodeInfo[] @relation("Children")
  parents     CodeInfo[] @relation("Children")
  sections    Section[] // Section.paramInfo
  kwargOwner  KwargCol[] @relation("KwargOwner") // KwargCol.codeInfo
  kwarg       KwargCol[] @relation("Kwarg") // KwargCol.kwargInfo
  evOwner     EVCol[] // EV.codeInfo
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String @db.VarChar(255)
  password String
}

model Section {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @db.VarChar(255)
  paramInfo   CodeInfo?         @relation(fields: [paramInfoId], references: [id])
  paramInfoId String            @db.Uuid
  children    SectionChildrenId @relation(fields: [childrenId], references: [id])
  childrenId  String            @db.Uuid
  siblings    SectionChildren[] //SectionChildren.section
  evChild     EV[] //EV.child
}

model SectionChildrenId {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children SectionChildren[]
  parents  Section[] //Section.children
}

model SectionChildren {
  id        SectionChildrenId @relation(fields: [idid], references: [id])
  idid      String            @db.Uuid
  section   Section           @relation(fields: [sectionId], references: [id])
  sectionId String            @db.Uuid
  order     Int

  @@id([idid, sectionId]) // composite key
}

model KwargColId {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  KwargCol KwargCol[]
}

model KwargCol {
  id          KwargColId @relation(fields: [idid], references: [id])
  idid        String     @db.Uuid
  codeInfo    CodeInfo   @relation("KwargOwner", fields: [codeInfoId], references: [id])
  codeInfoId  String     @db.Uuid
  kwargInfo   CodeInfo   @relation("Kwarg", fields: [kwargInfoId], references: [id])
  kwargInfoId String     @db.Uuid
  order       Int

  @@id([idid, codeInfoId, kwargInfoId]) // composite key
}

model EVColId {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  EVCol EVCol[]
}

model EVCol {
  id         EVColId  @relation(fields: [idid], references: [id])
  idid       String   @db.Uuid
  codeInfo   CodeInfo @relation(fields: [codeInfoId], references: [id])
  codeInfoId String   @db.Uuid
  ev         EV       @relation(fields: [evId], references: [id])
  evId       String   @db.Uuid

  @@id([idid, codeInfoId]) // composite key
}

model EV {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  value   String  @db.VarChar(255)
  child   Section @relation(fields: [childId], references: [id])
  childId String  @db.Uuid
  evCol   EVCol[] //EVCol.ev
}
