generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["extendedWhereUnique"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model CodeInfo {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String                     @db.VarChar(255)
  version                   String?                    @db.VarChar(255)
  defaultVal                String?                    @db.VarChar(255)
  type                      String                     @db.Text
  rcType                    String                     @db.VarChar(255)
  description               String?                    @db.VarChar(255)
  path                      String?                    @db.VarChar(255)
  inCodeParent              CodeInfo?                  @relation("InCodeDirectParent", fields: [inCodeParentId], references: [id])
  inCodeChildren            CodeInfo[]                 @relation("InCodeDirectParent")
  inCodeParentId            String?                    @db.Uuid
  returnType                CodeInfo?                  @relation("ReturnType", fields: [returnTypeId], references: [id])
  returnTypeOf              CodeInfo[]                 @relation("ReturnType")
  returnTypeId              String?                    @db.Uuid
  sectionsParamInfo         Section[]                  @relation("SectionsParamInfo") // Section.paramInfo
  kwargOwner                KwargCol[]                 @relation("KwargOwner") // KwargCol.codeInfo
  kwarg                     KwargCol[]                 @relation("Kwarg") // KwargCol.kwargInfo
  evOwner                   EVCol[] // EVCol.codeInfo
  sectionsSelectedItem      Section[]                  @relation("SectionsSelectedItem") //Section.selectedItem
  asUserSpecifiedObject     Section[]                  @relation("SectionUserSpecifiedObject") //Section.userSpecifiedObject
  uiTypeCols                UITypeCol[] //UITypeCol.codeInfo
  sectionUITypes            SectionUIType[] //SectionUIType.collections
  asParent                  CodeInfoChildren[]         @relation("CodeInfoParent") // CodeInfoChildren.parent
  asChild                   CodeInfoChildren[]         @relation("CodeInfoChildren") // CodeInfoChildren.child
  userCodeInfoMaps          UserCodeInfoMap[] //UserCodeInfoMap.codeInfo
  projectConfigCodeInfoMaps ProjectConfigCodeInfoMap[] //ProjectConfigCodeInfoMap.codeInfo
}

model CodeInfoChildren {
  parent   CodeInfo @relation("CodeInfoParent", fields: [parentId], references: [id])
  parentId String   @db.Uuid
  child    CodeInfo @relation("CodeInfoChildren", fields: [childId], references: [id])
  childId  String   @db.Uuid
  order    Int

  @@id([parentId, childId]) // composite key
}

model User {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String                @unique @db.VarChar(255)
  password         Bytes
  salt             Bytes
  projects         Project[] //Project.owner
  runs             Run[] //Run.owner
  uiTypes          UIType[] //UIType.owner
  codeInfoTypeMaps UserCodeInfoTypeMap[] //UserCodeInfoTypeMap.owner
  codeInfoMaps     UserCodeInfoMap[] //UserCodeInfoMap.owner
}

model Section {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                  @db.VarChar(255)
  paramInfo             CodeInfo?               @relation("SectionsParamInfo", fields: [paramInfoId], references: [id])
  paramInfoId           String?                 @db.Uuid
  width                 Int
  height                Int
  chainedFrom           Section?                @relation("SectionChainedFrom", fields: [chainedFromId], references: [id])
  chainedTo             Section[]               @relation("SectionChainedFrom")
  chainedFromId         String?                 @db.Uuid
  zIndex                Int
  evCol                 EVColId?                @relation(fields: [evColId], references: [id])
  evColId               String?                 @db.Uuid
  kwargCol              KwargColId?             @relation(fields: [kwargColId], references: [id])
  kwargColId            String?                 @db.Uuid
  selectedItem          CodeInfo?               @relation("SectionsSelectedItem", fields: [selectedItemId], references: [id])
  selectedItemId        String?                 @db.Uuid
  uiType                UIType?                 @relation(fields: [uiTypeId], references: [id])
  uiTypeId              String?                 @db.Uuid
  uiTypeCol             UITypeColId?            @relation(fields: [uiTypeColId], references: [id])
  uiTypeColId           String?                 @db.Uuid
  social                String?
  outputGroup           OutputGroup?            @relation(references: [id], fields: [outputGroupId])
  outputGroupId         String?                 @db.Uuid
  userSpecifiedObject   CodeInfo?               @relation("SectionUserSpecifiedObject", references: [id], fields: [userSpecifiedObjectId])
  userSpecifiedObjectId String?                 @db.Uuid
  description           String?
  descriptionHeight     Float
  descriptionVisible    Boolean
  nonPresetUITypes      UIType[]                @relation("sectionNonPresetUITypes")
  children              SectionChildren[]       @relation("SectionParent") // SectionChildren.parent
  asChild               SectionChildren?        @relation("SectionChildren") // SectionChildren.child
  asChildId             String?                 @db.Uuid
  projectConfigs        ProjectConfigChildren[] @relation("ProjectConfigChildren") // ProjectConfigChildren.child
}

model SectionChildren {
  child    Section @relation("SectionChildren", references: [id], fields: [childId])
  childId  String  @db.Uuid
  parent   Section @relation("SectionParent", fields: [parentId], references: [id])
  parentId String  @db.Uuid
  order    Int
  x        Float   @default(0)
  y        Float   @default(0)

  @@id([childId])
}

model KwargColId {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children KwargCol[]
  sections Section[] //Section.kwargColId
}

model KwargCol {
  id          KwargColId @relation(fields: [idid], references: [id])
  idid        String     @db.Uuid
  codeInfo    CodeInfo   @relation("KwargOwner", fields: [codeInfoId], references: [id])
  codeInfoId  String     @db.Uuid
  kwargInfo   CodeInfo   @relation("Kwarg", fields: [kwargInfoId], references: [id])
  kwargInfoId String     @db.Uuid
  order       Int

  @@id([idid, codeInfoId, kwargInfoId]) // composite key
}

model EVColId {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children EVCol[]
  sections Section[] //Section.evColId
}

model EVCol {
  id         EVColId  @relation(fields: [idid], references: [id])
  idid       String   @db.Uuid
  codeInfo   CodeInfo @relation(fields: [codeInfoId], references: [id])
  codeInfoId String   @db.Uuid
  ev         EV       @relation(fields: [evId], references: [id])
  evId       String   @db.Uuid

  @@id([idid, codeInfoId]) // composite key
}

model EV {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  value String? @db.VarChar(255)
  evCol EVCol[] //EVCol.ev
}

model UIType {
  id                            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                          String                         @db.VarChar(255)
  owner                         User?                          @relation(fields: [ownerId], references: [id])
  ownerId                       String?                        @db.Uuid
  type                          String                         @db.VarChar(255)
  presetType                    String?                        @db.VarChar(255)
  sections                      Section[] //Section.uiTypeId
  uiTypeCols                    UITypeCol[] //UITypeCol.uiType
  sectionUIType                 SectionUIType? //SectionUIType.id
  sliderUIType                  SliderUIType? //SliderUIType.id
  textUIType                    TextUIType? //TextUIType.id
  switchUIType                  SwitchUIType? //SwitchUIType.id
  refUIType                     RefUIType? //RefUIType.id
  userCodeInfoTypeMaps          UserCodeInfoTypeMap[] //UserCodeInfoTypeMap.uiTypeId
  projectConfigCodeInfoTypeMaps ProjectConfigCodeInfoTypeMap[] //ProjectConfigCodeInfoTypeMaps.uiTypeId
  userCodeInfoMaps              UserCodeInfoMap[] //UserCodeInfoMap.uiTypeId
  projectConfigCodeInfoMaps     ProjectConfigCodeInfoMap[] //ProjectConfigCodeInfoMap.uiTypeId
  asNonPresetForSection         Section?                       @relation("sectionNonPresetUITypes", references: [id], fields: [asNonPresetForSectionId]) //Section.nonPresetUITypes
  asNonPresetForSectionId       String?                        @db.Uuid
  asNonPresetForUITypeCol       UITypeCol?                     @relation("uiTypeColNonPresetUITypes", references: [idid, codeInfoId], fields: [asNonPresetForUITypeColId, asNonPresetForCodeInfoId]) //UITypeCol.nonPresetUITypes
  asNonPresetForUITypeColId     String?                        @db.Uuid //UITypeCol.idid 
  asNonPresetForCodeInfoId      String?                        @db.Uuid //UITypeCol.codeInfoId
}

model UITypeColId {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children UITypeCol[]
  sections Section[] //Section.uiTypeColId
}

model UITypeCol {
  id               UITypeColId @relation(fields: [idid], references: [id])
  idid             String      @db.Uuid
  codeInfo         CodeInfo    @relation(fields: [codeInfoId], references: [id])
  codeInfoId       String      @db.Uuid
  uiType           UIType      @relation(fields: [uiTypeId], references: [id])
  uiTypeId         String      @db.Uuid
  nonPresetUITypes UIType[]    @relation("uiTypeColNonPresetUITypes")

  @@id([idid, codeInfoId]) // composite key
}

model SectionUIType {
  id            UIType         @relation(fields: [idid], references: [id])
  idid          String         @db.Uuid
  collections   CodeInfo[]
  subType       String?        @db.VarChar(255)
  childUIType   SectionUIType? @relation("ChildUIType", fields: [childUITypeId], references: [idid])
  childUITypeId String?        @unique @db.Uuid
  parentUIType  SectionUIType? @relation("ChildUIType")

  @@id([idid])
}

model SliderUIType {
  id   UIType @relation(fields: [idid], references: [id])
  idid String @db.Uuid
  min  Float?
  max  Float?
  step Float?

  @@id([idid])
}

model TextUIType {
  id   UIType @relation(fields: [idid], references: [id])
  idid String @db.Uuid

  @@id([idid])
}

model SwitchUIType {
  id   UIType @relation(fields: [idid], references: [id])
  idid String @db.Uuid

  @@id([idid])
}

model RefUIType {
  id   UIType @relation(fields: [idid], references: [id])
  idid String @db.Uuid

  @@id([idid])
}

model Project {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String          @db.VarChar(255)
  owner           User            @relation(fields: [ownerId], references: [id])
  ownerId         String          @db.Uuid
  configs         ProjectConfig[] @relation("configs") //ProjectConfig.project
  defaultConfig   ProjectConfig?  @relation(fields: [defaultConfigId], references: [id])
  defaultConfigId String?         @unique @db.Uuid

  @@unique([name, ownerId])
}

model ProjectConfig {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String                         @db.VarChar(255)
  project          Project                        @relation("configs", fields: [projectId], references: [id])
  projectId        String                         @db.Uuid
  codeInfoTypeMaps ProjectConfigCodeInfoTypeMap[] //ProjectConfigCodeInfoTypeMap.projectConfig
  codeInfoMaps     ProjectConfigCodeInfoMap[] //ProjectConfigCodeInfoMap.projectConfig
  runs             Run[]
  sections         ProjectConfigChildren[]        @relation("ProjectConfigParent") // ProjectConfigChildren.parent
  isDefaultFor     Project?

  @@unique([name, projectId])
}

model ProjectConfigChildren {
  parent   ProjectConfig @relation("ProjectConfigParent", fields: [parentId], references: [id])
  parentId String        @db.Uuid
  child    Section       @relation("ProjectConfigChildren", fields: [childId], references: [id])
  childId  String        @db.Uuid
  x        Float         @default(0)
  y        Float         @default(0)

  @@id([parentId, childId]) // composite key
}

model UserCodeInfoTypeMap {
  owner    User   @relation(fields: [ownerId], references: [id])
  ownerId  String @db.Uuid
  type     String
  uiType   UIType @relation(fields: [uiTypeId], references: [id])
  uiTypeId String @db.Uuid

  @@id([ownerId, type])
}

model ProjectConfigCodeInfoTypeMap {
  projectConfig   ProjectConfig @relation(fields: [projectConfigId], references: [id])
  projectConfigId String        @db.Uuid
  type            String
  uiType          UIType        @relation(fields: [uiTypeId], references: [id])
  uiTypeId        String        @db.Uuid

  @@id([projectConfigId, type])
}

model UserCodeInfoMap {
  owner      User     @relation(fields: [ownerId], references: [id])
  ownerId    String   @db.Uuid
  codeInfo   CodeInfo @relation(fields: [codeInfoId], references: [id])
  codeInfoId String   @db.Uuid
  uiType     UIType   @relation(fields: [uiTypeId], references: [id])
  uiTypeId   String   @db.Uuid

  @@id([ownerId, codeInfoId])
}

model ProjectConfigCodeInfoMap {
  projectConfig   ProjectConfig @relation(fields: [projectConfigId], references: [id])
  projectConfigId String        @db.Uuid
  codeInfo        CodeInfo      @relation(fields: [codeInfoId], references: [id])
  codeInfoId      String        @db.Uuid
  uiType          UIType        @relation(fields: [uiTypeId], references: [id])
  uiTypeId        String        @db.Uuid

  @@id([projectConfigId, codeInfoId])
}

model Run {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  owner           User          @relation(fields: [ownerId], references: [id])
  ownerId         String        @db.Uuid
  projectConfig   ProjectConfig @relation(fields: [projectConfigId], references: [id])
  projectConfigId String        @db.Uuid
  code            String        @db.Text
  outputGroups    OutputGroup[]
}

model OutputGroup {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  children Output[]
  run      Run       @relation(fields: [runId], references: [id])
  runId    String    @db.Uuid
  sections Section[] //Section.outputGroup

  @@unique([name, runId])
}

model Output {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  values        Float[]
  outputGroup   OutputGroup @relation(fields: [outputGroupId], references: [id])
  outputGroupId String      @db.Uuid

  @@unique([name, outputGroupId])
}
