generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CodeInfo {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @db.VarChar(255)
  version     String?    @db.VarChar(255)
  defaultVal  String?    @db.VarChar(255)
  type        String     @db.VarChar(255)
  rcType      String     @db.VarChar(255)
  description String?    @db.VarChar(255)
  path        String?    @db.VarChar(255)
  children    CodeInfo[] @relation("Children")
  parents     CodeInfo[] @relation("Children")
  sections    Section[] // Section.paramInfo
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String @db.VarChar(255)
  password String
}

model Section {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @db.VarChar(255)
  paramInfo   CodeInfo?         @relation(fields: [paramInfoId], references: [id])
  paramInfoId String            @db.Uuid
  children    SectionChildrenId @relation(fields: [childrenId], references: [id])
  childrenId  String            @db.Uuid
  siblings    SectionChildren[] //SectionChildren.section
}

model SectionChildrenId {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children SectionChildren[]
  parents  Section[] //Section.children
}

model SectionChildren {
  id        SectionChildrenId @relation(fields: [idid], references: [id])
  idid      String            @db.Uuid
  section   Section           @relation(fields: [sectionId], references: [id])
  sectionId String            @db.Uuid
  order     Int

  @@id([idid, sectionId]) // composite key
}
