generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CodeInfo {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @db.VarChar(255)
  version     String?    @db.VarChar(255)
  defaultVal  String?    @db.VarChar(255)
  type        String     @db.VarChar(255)
  rcType      String     @db.VarChar(255)
  description String?    @db.VarChar(255)
  path        String?    @db.VarChar(255)
  children    CodeInfo[] @relation("Children")
  parents     CodeInfo[] @relation("Children")
  sections    Sections[] // Sections.paramInfo
}

model Users {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String @db.VarChar(255)
  password String
}

model Sections {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String             @db.VarChar(255)
  paramInfo   CodeInfo?          @relation(fields: [paramInfoId], references: [id])
  paramInfoId String             @db.Uuid
  children    SectionChildrenIds @relation(fields: [childrenId], references: [id])
  childrenId  String             @db.Uuid
  siblings    SectionChildren[] //SectionChildren.section
}

model SectionChildrenIds {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children SectionChildren[]
  parents  Sections[] //Sections.children
}

model SectionChildren {
  sectionChildrenId    SectionChildrenIds @relation(fields: [sectionChildrenIdsId], references: [id])
  sectionChildrenIdsId String             @db.Uuid
  section              Sections           @relation(fields: [sectionId], references: [id])
  sectionId            String             @db.Uuid
  order                Int

  @@id([sectionChildrenIdsId, sectionId]) // composite key
}
