generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CodeInfo {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @db.VarChar(255)
  version        String?         @db.VarChar(255)
  defaultVal     String?         @db.VarChar(255)
  type           String          @db.VarChar(255)
  rcType         String          @db.VarChar(255)
  description    String?         @db.VarChar(255)
  path           String?         @db.VarChar(255)
  children       CodeInfo[]      @relation("Children")
  parents        CodeInfo[]      @relation("Children")
  sections       Section[] // Section.paramInfo
  kwargOwner     KwargCol[]      @relation("KwargOwner") // KwargCol.codeInfo
  kwarg          KwargCol[]      @relation("Kwarg") // KwargCol.kwargInfo
  evOwner        EVCol[] // EV.codeInfo
  sectionConfigs SectionConfig[] //SectionConfig.selectedItem
  uiTypeOrigins  UIType[] //UIType.originCodeInfo
  uiTypeCols     UITypeCol[] //UITypeCol.codeInfo
  sectionUITypes SectionUIType[] //SectionUIType.collections
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String @db.VarChar(255)
  password String
}

model Section {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String             @db.VarChar(255)
  paramInfo      CodeInfo?          @relation(fields: [paramInfoId], references: [id])
  paramInfoId    String             @db.Uuid
  children       SectionChildrenId  @relation(fields: [childrenId], references: [id])
  childrenId     String             @db.Uuid
  siblings       SectionChildren[] //SectionChildren.section
  evChildren     EV[] //EV.child
  sectionConfigs SectionConfigCol[] //SectionConfigCol.section
  uiTypeOrigins  UIType[] //UIType.originSection
}

model SectionChildrenId {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children SectionChildren[]
  parents  Section[] //Section.children
}

model SectionChildren {
  id        SectionChildrenId @relation(fields: [idid], references: [id])
  idid      String            @db.Uuid
  section   Section           @relation(fields: [sectionId], references: [id])
  sectionId String            @db.Uuid
  order     Int

  @@id([idid, sectionId]) // composite key
}

model KwargColId {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children       KwargCol[]
  sectionConfigs SectionConfig[] //SectionConfig.kwargCol
}

model KwargCol {
  id          KwargColId @relation(fields: [idid], references: [id])
  idid        String     @db.Uuid
  codeInfo    CodeInfo   @relation("KwargOwner", fields: [codeInfoId], references: [id])
  codeInfoId  String     @db.Uuid
  kwargInfo   CodeInfo   @relation("Kwarg", fields: [kwargInfoId], references: [id])
  kwargInfoId String     @db.Uuid
  order       Int

  @@id([idid, codeInfoId, kwargInfoId]) // composite key
}

model EVColId {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children       EVCol[]
  sectionConfigs SectionConfig[] //SectionConfig.evCol
}

model EVCol {
  id         EVColId  @relation(fields: [idid], references: [id])
  idid       String   @db.Uuid
  codeInfo   CodeInfo @relation(fields: [codeInfoId], references: [id])
  codeInfoId String   @db.Uuid
  ev         EV       @relation(fields: [evId], references: [id])
  evId       String   @db.Uuid

  @@id([idid, codeInfoId]) // composite key
}

model EV {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  value   String  @db.VarChar(255)
  child   Section @relation(fields: [childId], references: [id])
  childId String  @db.Uuid
  evCol   EVCol[] //EVCol.ev
}

model SectionConfigColId {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children SectionConfigCol[]
}

model SectionConfigCol {
  id        SectionConfigColId @relation(fields: [idid], references: [id])
  idid      String             @db.Uuid
  section   Section            @relation(fields: [sectionId], references: [id])
  sectionId String             @db.Uuid
  config    SectionConfig      @relation(fields: [configId], references: [id])
  configId  String             @db.Uuid

  @@id([idid, sectionId]) // composite key
}

model SectionConfig {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evCol          EVColId            @relation(fields: [evColId], references: [id])
  evColId        String             @db.Uuid
  kwargCol       KwargColId         @relation(fields: [kwargColId], references: [id])
  kwargColId     String             @db.Uuid
  selectedItem   CodeInfo           @relation(fields: [selectedItemId], references: [id])
  selectedItemId String             @db.Uuid
  uiType         UIType             @relation(fields: [uiTypeId], references: [id])
  uiTypeId       String             @db.Uuid
  configCol      SectionConfigCol[] //SectionConfigCol.config
}

model UIType {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String          @db.VarChar(255)
  type                     String          @db.VarChar(255)
  presetType               String          @db.VarChar(255)
  originSection            Section         @relation(fields: [originSectionId], references: [id])
  originSectionId          String          @db.Uuid
  originUITypeCol          UITypeColId     @relation(fields: [originUITypeColId], references: [id])
  originUITypeColId        String          @db.Uuid
  originCodeInfo           CodeInfo        @relation(fields: [originCodeInfoId], references: [id])
  originCodeInfoId         String          @db.Uuid
  isForChildOfOriginInfoId Boolean
  sectionConfigs           SectionConfig[] //SectionConfig.uiType
  uiTypeCols               UITypeCol[] //UITypeCol.uiType
  sectionUITypes           SectionUIType[] //SectionUIType.id
  sliderUITypes            SliderUIType[] //SliderUIType.id
  textUITypes              TextUIType[] //TextUIType.id
  switchUITYpes            SwitchUIType[] //SwitchUIType.id
  refUITypes               RefUIType[] //RefUIType.id
}

model UITypeColId {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  children      UITypeCol[]
  uiTypeOrigins UIType[] //UIType.originUITypeCol
  sectionUIType SectionUIType[] //SectionUIType.uiTypeCol
}

model UITypeCol {
  id         UITypeColId @relation(fields: [idid], references: [id])
  idid       String      @db.Uuid
  codeInfo   CodeInfo    @relation(fields: [codeInfoId], references: [id])
  codeInfoId String      @db.Uuid
  uiType     UIType      @relation(fields: [uiTypeId], references: [id])
  uiTypeId   String      @db.Uuid

  @@id([idid, codeInfoId]) // composite key
}

model SectionUIType {
  id            UIType         @relation(fields: [idid], references: [id])
  idid          String         @db.Uuid
  collections   CodeInfo[]
  uiTypeCol     UITypeColId    @relation(fields: [uiTypeColId], references: [id])
  uiTypeColId   String         @db.Uuid
  subType       String         @db.VarChar(255)
  childUIType   SectionUIType? @relation("ChildUIType", fields: [childUITypeId], references: [idid])
  childUITypeId String         @unique @db.Uuid
  parentUIType  SectionUIType? @relation("ChildUIType")

  @@id([idid])
}

model SliderUIType {
  id   UIType @relation(fields: [idid], references: [id])
  idid String @db.Uuid
  min  Float
  max  Float
  step Float

  @@id([idid])
}

model TextUIType {
  id   UIType @relation(fields: [idid], references: [id])
  idid String @db.Uuid

  @@id([idid])
}

model SwitchUIType {
  id   UIType @relation(fields: [idid], references: [id])
  idid String @db.Uuid

  @@id([idid])
}

model RefUIType {
  id   UIType @relation(fields: [idid], references: [id])
  idid String @db.Uuid

  @@id([idid])
}
