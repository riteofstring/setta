{
  "name": "setta-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm typecheck && electron-vite build",
    "dev": "electron-vite dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "generate:workflow-graph-font": "node scripts/generate-workflow-graph-font.mjs",
    "deadcode": "knip --no-config-hints",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:electron": "pnpm build && pnpm test:electron:built",
    "test:electron:built": "node tests/electron/run-workflows.mjs --tier required",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.16.0",
    "pixi-viewport": "6.0.3",
    "pixi.js": "8.18.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-virtuoso": "4.18.7",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pixi/msdf-bmfont-xml": "3.0.0",
    "@swc/core": "1.15.33",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.7.0",
    "electron-vite": "5.0.0",
    "eslint": "10.4.0",
    "globals": "17.6.0",
    "knip": "6.13.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "7.3.3",
    "vitest": "4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "@babel/code-frame": "7.29.0",
      "@babel/compat-data": "7.29.3",
      "@babel/core": "7.29.0",
      "@babel/generator": "7.29.1",
      "@babel/helper-compilation-targets": "7.28.6",
      "@babel/helper-globals": "7.28.0",
      "@babel/helper-module-imports": "7.28.6",
      "@babel/helper-module-transforms": "7.28.6",
      "@babel/helper-plugin-utils": "7.28.6",
      "@babel/helper-string-parser": "7.27.1",
      "@babel/helper-validator-identifier": "7.28.5",
      "@babel/helper-validator-option": "7.27.1",
      "@babel/helpers": "7.29.2",
      "@babel/parser": "7.29.3",
      "@babel/plugin-transform-arrow-functions": "7.27.1",
      "@babel/plugin-transform-react-jsx-self": "7.27.1",
      "@babel/plugin-transform-react-jsx-source": "7.27.1",
      "@babel/template": "7.28.6",
      "@babel/traverse": "7.29.0",
      "@babel/types": "7.29.0",
      "@typescript-eslint/eslint-plugin": "8.59.4",
      "@typescript-eslint/parser": "8.59.4",
      "@typescript-eslint/project-service": "8.59.4",
      "@typescript-eslint/scope-manager": "8.59.4",
      "@typescript-eslint/tsconfig-utils": "8.59.4",
      "@typescript-eslint/type-utils": "8.59.4",
      "@typescript-eslint/types": "8.59.4",
      "@typescript-eslint/typescript-estree": "8.59.4",
      "@typescript-eslint/utils": "8.59.4",
      "@typescript-eslint/visitor-keys": "8.59.4",
      "@oxc-resolver/binding-android-arm-eabi": "11.19.1",
      "@oxc-resolver/binding-android-arm64": "11.19.1",
      "@oxc-resolver/binding-darwin-arm64": "11.19.1",
      "@oxc-resolver/binding-darwin-x64": "11.19.1",
      "@oxc-resolver/binding-freebsd-x64": "11.19.1",
      "@oxc-resolver/binding-linux-arm-gnueabihf": "11.19.1",
      "@oxc-resolver/binding-linux-arm-musleabihf": "11.19.1",
