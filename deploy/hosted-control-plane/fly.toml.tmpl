app = "{{ .FlyAppName }}"
primary_region = "{{ .FlyRegion }}"

[build]
  dockerfile = "Dockerfile"

[env]
  SETTA_CONTROL_PLANE_DATA_DIR = "/data/control-plane"
  SETTA_CONTROL_PLANE_HOST = "0.0.0.0"
  SETTA_CONTROL_PLANE_RUNTIME_TARGET = "127.0.0.1:7345"
  SETTA_CONTROL_PLANE_SECRET_DIR = "/data/runtime-secrets"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0
  processes = ["app"]

  [http_service.concurrency]
    type = "requests"
    hard_limit = 64

  [[http_service.checks]]
    grace_period = "5s"
    interval = "10s"
    method = "GET"
    path = "/healthz"
    timeout = "2s"

[[mounts]]
  source = "{{ .VolumeName }}"
  destination = "/data"
  scheduled_snapshots = false

[[vm]]
  cpu_kind = "shared"
  cpus = 1
  memory = "256mb"
