  "keyBindingLabels": [
    {
      "label": "Canvas",
      "chord": "Drag empty space to pan. Press F to fit the workspace."
    },
    {
      "label": "Sections",
      "chord": "Drag a surface to move it. Hold Alt while dragging to nest it."
    },
    {
      "label": "Parameters",
      "chord": "Hold Cmd/Ctrl+Shift and click rows. Use Alt+Arrow to move or Tab to indent."
    },
    {
      "label": "Menus",
      "chord": "Right-click, or use Shift+F10 from the keyboard."
    },
    {
      "label": "Toolbar",
      "chord": "Host controls sit above and below the zoom group. The top one adds a note."
    },
    {
      "label": "Control help",
      "chord": "Hold Q while hovering a parameter control."
    },
    {
      "label": "Group",
      "chord": "⌘ + G"
    },
    {
      "label": "Ungroup",
      "chord": "⌘ + Shift + G"
    },
    {
      "label": "Delete",
      "chord": "Backspace"
    },
    {
      "label": "Lock Position & Size",
      "chord": "⌘ + Alt + L"
    },
    {
      "label": "Unlock Position & Size",
      "chord": "⌘ + Alt + U"
    },
    {
      "label": "Select all",
      "chord": "⌘ + A"
    },
    {
      "label": "Select top-level non-group sections",
      "chord": "⌘ + Shift + A"
    },
    {
      "label": "Focus next section",
      "chord": "Alt + J"
