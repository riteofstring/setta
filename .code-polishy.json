{
  "version": 3,
  "project": {
    "kind": "application",
    "capabilities": ["backend", "frontend", "ui"]
  },
  "documentation": {
    "design": [
      {
        "path": "docs/design/development-tooling.md",
        "sourcePaths": [
          "apps/playground/vitest.config.ts",
          "apps/playground/vitest.setup.ts",
          "packages/workspace/vite.config.ts",
          "packages/workspace/vitest.setup.ts",
          "scripts/cdp-port.sh",
          "scripts/chrome-devtools-mcp.sh"
        ]
      },
      {
        "path": "docs/design/python-canvas-backend.md",
        "module": "python-canvas-backend"
      },
      {
        "path": "docs/design/python-canvas-frontend.md",
        "module": "python-canvas-frontend"
      },
      {
        "path": "docs/design/workspace.md",
        "module": "workspace"
      }
    ]
  },
  "scope": {
    "generated": [
      "apps/python-canvas/backend/internal/contracts/testdata/project-snapshot-v2.json",
      "apps/python-canvas/src/backend/generatedContract.ts",
      "docs/evidence/**/*.json",
      "docs/evidence/**/*.json.gz"
    ],
    "entryPoints": [
      "apps/playground/vitest.setup.ts",
      "apps/python-canvas/backend/cmd/python-canvas/main.go",
      "apps/python-canvas/src/main.tsx",
      "apps/python-canvas/vitest.setup.ts",
      "packages/workspace/tailwind-preset.mjs",
      "packages/workspace/tailwind.config.d.ts",
      "packages/workspace/vitest.setup.ts",
      "scripts/check-package-boundary.mjs",
      "scripts/check-workspace-policy.mjs",
      "scripts/compile-katex-styles.mjs",
      "scripts/profile-workspace-performance.mjs",
      "scripts/verify-packed-consumer.mjs"
    ],
    "development": [
      "apps/playground/**",
      "apps/python-canvas/vite.config.ts",
      "apps/python-canvas/vitest.config.ts",
      "apps/python-canvas/vitest.setup.ts",
      "fixtures/**",
      "packages/workspace/tailwind.config.js",
      "packages/workspace/vite.config.ts",
      "packages/workspace/vitest.setup.ts",
      "scripts/**"
    ]
  },
  "quality": {
    "allowComments": false
  },
  "portability": {},
  "modules": [
    {
      "name": "workspace",
      "paths": ["packages/workspace/**", "scripts/**", "fixtures/**"]
    },
    {
      "name": "playground",
      "paths": ["apps/playground/**"],
      "dependsOn": ["workspace"]
    },
    {
      "name": "python-canvas-backend",
      "paths": ["apps/python-canvas/backend/**"]
    },
    {
      "name": "python-canvas-frontend",
      "paths": ["apps/python-canvas/*", "apps/python-canvas/src/**"],
      "dependsOn": ["workspace", "python-canvas-backend"]
    },
    {
      "name": "setta-runtime",
      "paths": [
        "packages/setta-runtime/**",
        "pyproject.toml",
        "uv.lock",
        "uv.toml"
      ],
      "dependsOn": ["python-canvas-backend", "python-canvas-frontend"]
    }
  ],
  "checks": [
    {
      "name": "setta-package-contract",
      "provides": ["package-contract"],
      "argv": ["node", "scripts/check-package-boundary.mjs"],
      "modules": ["workspace", "playground"],
      "runOn": ["check", "gate"],
      "timeoutSeconds": 300
    },
    {
      "name": "workspace-build",
      "provides": ["build"],
      "argv": ["pnpm", "--filter", "@setta/workspace", "run", "build"],
      "modules": ["workspace"],
      "runOn": ["build"],
      "timeoutSeconds": 900
    },
    {
      "name": "playground-build",
      "provides": ["build"],
      "argv": ["pnpm", "--filter", "@setta/playground", "run", "build"],
      "modules": ["playground"],
      "runOn": ["build"],
      "timeoutSeconds": 900
    },
    {
      "name": "python-canvas-backend-build",
      "provides": ["build"],
      "argv": ["go", "build", "./..."],
      "cwd": "apps/python-canvas/backend",
      "modules": ["python-canvas-backend"],
      "runOn": ["build"],
      "timeoutSeconds": 300
    },
    {
      "name": "python-canvas-frontend-build",
      "provides": ["build"],
      "argv": ["pnpm", "--filter", "@setta/python-canvas", "run", "build"],
      "modules": ["python-canvas-frontend"],
      "runOn": ["build"],
      "timeoutSeconds": 900
    },
    {
      "name": "workspace-package-policy",
      "provides": ["workspace-policy"],
      "argv": ["node", "scripts/check-workspace-policy.mjs"],
      "modules": ["workspace", "playground"],
      "runOn": ["supply-chain"],
      "timeoutSeconds": 300
    },
    {
      "name": "setta-python-lock-sync",
      "provides": ["lock-sync"],
      "argv": ["uv", "lock", "--check"],
      "modules": ["setta-runtime"],
      "runOn": ["supply-chain"],
      "timeoutSeconds": 300
    },
    {
      "name": "setta-runtime-architecture",
      "provides": ["architecture"],
      "argv": [
        "python3",
        "packages/setta-runtime/scripts/check_runtime_boundary.py",
        "--check",
        "imports"
      ],
      "modules": ["setta-runtime"],
      "runOn": ["check", "gate"],
      "timeoutSeconds": 300
    },
    {
      "name": "setta-runtime-complexity",
      "provides": ["complexity"],
      "argv": [
        "python3",
        "packages/setta-runtime/scripts/check_runtime_boundary.py",
        "--check",
        "complexity"
      ],
      "modules": ["setta-runtime"],
      "runOn": ["check", "gate"],
      "timeoutSeconds": 300
    },
    {
      "name": "setta-runtime-typecheck",
      "provides": ["typecheck"],
      "argv": [
        "uv",
        "run",
        "--frozen",
        "--no-sync",
        "basedpyright",
        "--level",
        "error",
        "packages/setta-runtime/src/setta"
      ],
      "modules": ["setta-runtime"],
      "runOn": ["check", "gate"],
      "timeoutSeconds": 300
    },
    {
      "name": "setta-runtime-build",
      "provides": ["build"],
      "argv": [
        "python3",
        "packages/setta-runtime/scripts/build_setta_wheel.py"
      ],
      "modules": ["setta-runtime"],
      "runOn": ["build"],
      "timeoutSeconds": 1800
    }
  ],
  "tests": {
    "requiredKinds": ["component", "browser", "contract"],
    "suites": [
      {
        "name": "setta-runtime-focused",
        "kind": "unit",
        "scope": "module",
        "cost": "quick",
        "modules": ["setta-runtime"],
        "argv": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "packages/setta-runtime/tests",
          "-t",
          "packages/setta-runtime",
          "-p",
          "test_*.py"
        ],
        "runOn": ["focused", "recommended", "full"],
        "timeoutSeconds": 300
      },
      {
        "name": "workspace-focused",
        "kind": "unit",
        "scope": "module",
        "cost": "quick",
        "modules": ["workspace"],
        "argv": [
          "pnpm",
          "--filter",
          "@setta/workspace",
          "exec",
          "vitest",
          "run",
          "src/publicApi.test.ts"
        ],
        "runOn": ["focused", "recommended", "full"],
        "timeoutSeconds": 300
      },
      {
        "name": "playground-focused",
        "kind": "component",
        "scope": "module",
        "cost": "quick",
        "modules": ["playground"],
        "argv": [
          "pnpm",
          "--filter",
          "@setta/playground",
          "run",
          "test:focused"
        ],
        "runOn": ["focused", "recommended", "full"],
        "timeoutSeconds": 300
      },
      {
        "name": "python-canvas-backend-focused",
        "kind": "unit",
        "scope": "module",
        "cost": "quick",
        "modules": ["python-canvas-backend"],
        "argv": ["go", "test", "./..."],
        "cwd": "apps/python-canvas/backend",
        "runOn": ["focused", "recommended", "full"],
        "timeoutSeconds": 300
      },
      {
        "name": "python-canvas-frontend-focused",
        "kind": "component",
        "scope": "module",
        "cost": "quick",
        "modules": ["python-canvas-frontend"],
        "argv": ["pnpm", "--filter", "@setta/python-canvas", "test"],
        "runOn": ["focused", "recommended", "full"],
        "timeoutSeconds": 600
      },
      {
        "name": "workspace-component",
        "kind": "component",
        "scope": "module",
        "cost": "standard",
        "modules": ["workspace"],
        "argv": ["pnpm", "--filter", "@setta/workspace", "test"],
        "runOn": ["recommended", "full"],
        "timeoutSeconds": 1200
      },
      {
        "name": "playground-component",
        "kind": "component",
        "scope": "module",
        "cost": "standard",
        "modules": ["playground"],
        "argv": ["pnpm", "--filter", "@setta/playground", "test"],
        "runOn": ["recommended", "full"],
        "timeoutSeconds": 1200
      },
      {
        "name": "python-canvas-contract-drift",
        "kind": "contract",
        "scope": "repository",
        "cost": "quick",
        "paths": [
          "apps/python-canvas/backend/internal/contracts/**",
          "apps/python-canvas/src/backend/generatedContract.ts",
          "apps/python-canvas/package.json"
        ],
        "argv": [
          "pnpm",
          "--filter",
          "@setta/python-canvas",
          "run",
          "contract:check"
        ],
        "runOn": ["recommended", "full"],
        "timeoutSeconds": 300
      },
      {
        "name": "python-canvas-cross-language-boundary",
        "kind": "contract",
        "scope": "repository",
        "cost": "quick",
        "paths": [
          "apps/python-canvas/backend/internal/contracts/**",
          "apps/python-canvas/src/backend/**"
        ],
        "argv": [
          "pnpm",
          "--filter",
          "@setta/python-canvas",
          "exec",
          "vitest",
          "run",
          "src/backend/generatedContract.test.ts",
          "src/backend/runtimeContract.test.ts"
        ],
        "runOn": ["recommended", "full"],
        "timeoutSeconds": 300
      },
      {
        "name": "python-canvas-browser",
        "kind": "browser",
        "scope": "repository",
        "cost": "standard",
        "paths": ["apps/python-canvas/**"],
        "argv": [
          "pnpm",
          "--filter",
          "@setta/python-canvas",
          "run",
          "browser:test"
        ],
        "runOn": ["recommended", "full"],
        "timeoutSeconds": 300
      },
      {
        "name": "packed-consumer-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "expensive",
        "argv": ["pnpm", "run", "consumer:check"],
        "runOn": ["full"],
        "timeoutSeconds": 1800
      },
      {
        "name": "workspace-browser-profile",
        "kind": "browser",
        "scope": "repository",
        "cost": "expensive",
        "argv": ["pnpm", "run", "performance:profile", "--", "--passes", "1"],
        "runOn": ["full"],
        "timeoutSeconds": 1800
      }
    ]
  },
  "supplyChain": {
    "minimumReleaseAgeDays": 30,
    "auditLevel": "low",
    "allowedDependencyProtocols": ["workspace:"],
    "allowedLicenses": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "BlueOak-1.0.0",
      "CC0-1.0",
      "ISC",
      "MIT",
      "MIT-0",
      "MPL-2.0",
      "Python-2.0"
    ],
    "releaseArtifacts": [
      {
        "name": "go",
        "versionFile": "apps/python-canvas/backend/.go-version",
        "source": "go-toolchain"
      }
    ],
    "releaseAgeAssessments": [
      {
        "id": "go-1-26-6-security-fix",
        "ecosystem": "artifact",
        "package": "go",
        "version": "1.26.6",
        "scope": "apps/python-canvas/backend/.go-version",
        "category": "security-fix",
        "evidence": "https://groups.google.com/g/golang-announce/c/94pEornpRlI/m/_JhCbsOZBAAJ",
        "reason": "Go 1.26.6 fixes CVE-2026-56865 and CVE-2026-56864 in cmd/go checksum verification used when Setta resolves backend modules; retaining 1.26.2 would allow a malicious GOPROXY, or coordinated GOPROXY and GOSUMDB, to persist attacker-controlled module content.",
        "owner": "python-canvas-backend",
        "reviewed": "2026-08-26",
        "expires": "2026-09-12"
      },
      {
        "id": "nanoid-zero-size-security-fix",
        "ecosystem": "pnpm",
        "package": "nanoid",
        "version": "3.3.18",
        "scope": "pnpm-lock.yaml",
        "category": "security-fix",
        "evidence": "https://osv.dev/vulnerability/GHSA-2v37-7h3g-55p8",
        "reason": "This exact release fixes the high-severity infinite-loop vulnerability in the resolved nanoid 3.x line.",
        "owner": "workspace-extraction",
        "reviewed": "2026-08-16",
        "expires": "2026-09-06"
      }
    ]
  }
}
