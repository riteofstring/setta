{
  "version": 4,
  "project": {
    "kind": "library",
    "capabilities": ["frontend", "ui"]
  },
  "documentation": {
    "design": [
      {
        "path": "docs/design/development-tooling.md",
        "sourcePaths": [
          "packages/workspace/vite.config.ts",
          "packages/workspace/editorBuild.ts",
          "packages/workspace/vitest.setup.ts",
          "scripts/check-workspace-policy.mjs",
          "scripts/lib/cdp-client.mjs",
          "scripts/lib/headless-chrome.mjs",
          "scripts/profile-workspace-performance.mjs",
          "scripts/workspace-browser-interactions.mjs",
          "scripts/lib/browser-fixture.mjs",
          "scripts/lib/packed-consumer-browser.mjs",
          "scripts/verify-packed-consumer.mjs",
          "fixtures/packed-consumer/src/main.tsx",
          "fixtures/packed-consumer/src/browserFixture.tsx",
          "fixtures/packed-consumer/src/consumer.css",
          "fixtures/packed-consumer/index.html"
        ]
      },
      {
        "path": "docs/design/workspace.md",
        "module": "workspace"
      }
    ]
  },
  "scope": {
    "bundledDependencies": [
      {
        "manifest": "packages/workspace/package.json",
        "artifact": "packages/workspace/setta.tgz",
        "packages": [
          "@codemirror/autocomplete",
          "@codemirror/lang-javascript",
          "@codemirror/lang-json",
          "@codemirror/lang-markdown",
          "@codemirror/lang-python",
          "@codemirror/lang-yaml",
          "@codemirror/language",
          "@codemirror/legacy-modes",
          "@codemirror/lint",
          "@codemirror/state",
          "@codemirror/view",
          "@lezer/highlight",
          "@uiw/codemirror-theme-github",
          "@uiw/codemirror-themes",
          "@uiw/react-codemirror",
          "react-icons"
        ]
      }
    ],
    "entryPoints": [
      "packages/workspace/tailwind-preset.mjs",
      "packages/workspace/tailwind.config.d.ts",
      "packages/workspace/vitest.setup.ts",
      "scripts/check-package-boundary.mjs",
      "scripts/check-workspace-policy.mjs",
      "scripts/profile-workspace-performance.mjs",
      "scripts/workspace-browser-interactions.mjs",
      "scripts/verify-packed-consumer.mjs",
      "packages/workspace/src/browser/index.ts"
    ],
    "development": [
      "fixtures/**",
      "packages/workspace/tailwind.config.js",
      "packages/workspace/vite.config.ts",
      "packages/workspace/editorBuild.ts",
      "packages/workspace/vitest.setup.ts",
      "scripts/**"
    ]
  },
  "quality": {
    "allowComments": false,
    "lineBudget": {
      "production": 81000
    }
  },
  "portability": {},
  "modules": [
    {
      "name": "workspace",
      "paths": ["packages/workspace/**", "scripts/**", "fixtures/**"]
    }
  ],
  "checks": [
    {
      "name": "setta-package-contract",
      "provides": ["package-contract"],
      "argv": ["node", "scripts/check-package-boundary.mjs"],
      "modules": ["workspace"],
      "runOn": ["check", "gate"],
      "timeoutSeconds": 300
    },
    {
      "name": "workspace-build",
      "provides": ["build"],
      "argv": ["pnpm", "--filter", "@riteofstring/setta", "run", "build"],
      "modules": ["workspace"],
      "runOn": ["build"],
      "timeoutSeconds": 900
    },
    {
      "name": "workspace-package-policy",
      "provides": ["workspace-policy"],
      "argv": ["node", "scripts/check-workspace-policy.mjs"],
      "modules": ["workspace"],
      "runOn": ["supply-chain"],
      "timeoutSeconds": 300
    }
  ],
  "tests": {
    "paths": [
      "packages/workspace/src/**/*.test.ts",
      "packages/workspace/src/**/*.test.tsx"
    ],
    "ownership": [
      {
        "paths": [
          "packages/workspace/src/**/*.test.ts",
          "packages/workspace/src/**/*.test.tsx"
        ],
        "module": "workspace",
        "focusedSuite": "workspace-focused"
      }
    ],
    "requiredKinds": ["component", "browser", "contract"],
    "suites": [
      {
        "name": "workspace-focused",
        "kind": "component",
        "scope": "module",
        "cost": "quick",
        "modules": ["workspace"],
        "paths": [
          "packages/workspace/src/**/*.test.ts",
          "packages/workspace/src/**/*.test.tsx"
        ],
        "argv": ["pnpm", "--filter", "@riteofstring/setta", "test"],
        "runOn": ["focused", "recommended", "full"],
        "timeoutSeconds": 1200
      },
      {
        "name": "workspace-browser-interactions",
        "kind": "browser",
        "scope": "repository",
        "cost": "standard",
        "paths": [
          "packages/workspace/src/canvas/**",
          "packages/workspace/src/graph/**",
          "packages/workspace/src/windowing/**",
          "scripts/lib/cdp-client.mjs",
          "scripts/lib/headless-chrome.mjs",
          "scripts/workspace-browser-interactions.mjs",
          "fixtures/packed-consumer/**",
          "scripts/lib/browser-fixture.mjs"
        ],
        "argv": ["pnpm", "run", "workspace:browser:test"],
        "runOn": ["recommended", "full"],
        "timeoutSeconds": 900
      },
      {
        "name": "packed-consumer-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "expensive",
        "argv": ["pnpm", "run", "consumer:check"],
        "environment": ["CHROME_BINARY"],
        "runOn": ["full"],
        "timeoutSeconds": 1800
      },
      {
        "name": "workspace-browser-profile",
        "kind": "browser",
        "scope": "repository",
        "cost": "expensive",
        "argv": ["pnpm", "run", "performance:profile", "--", "--passes", "1"],
        "runOn": ["full"],
        "timeoutSeconds": 1800
      }
    ]
  },
  "supplyChain": {
    "minimumReleaseAgeDays": 30,
    "auditLevel": "low",
    "recurringSecurityMonitoring": true,
    "allowedDependencyProtocols": ["workspace:"],
    "allowedLicenses": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "BlueOak-1.0.0",
      "CC0-1.0",
      "ISC",
      "MIT",
      "MIT-0",
      "MPL-2.0",
      "Python-2.0"
    ],
    "releaseArtifacts": [
      {
        "name": "workspace-node",
        "versionFile": ".node-version",
        "source": "node-runtime"
      }
    ],
    "vulnerabilityAssessments": [
      {
        "id": "ghsa-8g5g-mxqh-grgj-6-4-4",
        "ecosystem": "pnpm",
        "advisory": "GHSA-8g5g-mxqh-grgj",
        "package": "vite",
        "affectedVersion": "6.4.4",
        "scope": "pnpm-lock.yaml",
        "severity": "moderate",
        "status": "not-affected",
        "basis": "unreachable",
        "reason": "The bypass needs a Vite development server reachable over the network. Repository commands run only vite build, Vitest's in-process server, and a fixed Node file server for browser checks; none starts a development server or sets a host. Trace and remediation: [docs/security/dependency-assessment-2026-10-09.md](docs/security/dependency-assessment-2026-10-09.md#addendum-2026-11-05-vite-644-and-katex-removal).",
        "impact": "The required network-exposed development server is absent in the checked-in commands. Reassess before adding a Vite dev server, --host, or server.host.",
        "evidence": "https://osv.dev/vulnerability/GHSA-8g5g-mxqh-grgj",
        "owner": "Claude",
        "reviewed": "2026-11-05",
        "expires": "2026-11-21"
      },
      {
        "id": "ghsa-rj75-hqrm-r3gf-6-0-10",
        "ecosystem": "pnpm",
        "advisory": "GHSA-rj75-hqrm-r3gf",
        "package": "postcss-selector-parser",
        "affectedVersion": "6.0.10",
        "scope": "pnpm-lock.yaml",
        "severity": "moderate",
        "status": "not-affected",
        "basis": "unreachable",
        "reason": "Tailwind 3.4.1 (through postcss-nested) and @tailwindcss/typography 0.5.9 parse selectors only while building the library stylesheet from src/styles/index.css and class names in ./src. The published package does not depend on either parser, and runtime project content is never compiled as CSS. Trace and remediation: [docs/security/dependency-assessment-2026-10-09.md](docs/security/dependency-assessment-2026-10-09.md#addendum-2026-11-06-postcss-selector-parser-review).",
        "impact": "The advisory prerequisites are absent from the published packages and checked-in build/test callers; reassess when those callers change.",
        "evidence": "https://osv.dev/vulnerability/GHSA-rj75-hqrm-r3gf",
        "owner": "Claude",
        "reviewed": "2026-11-06",
        "expires": "2026-11-19"
      },
      {
        "id": "ghsa-rj75-hqrm-r3gf-6-1-4",
        "ecosystem": "pnpm",
        "advisory": "GHSA-rj75-hqrm-r3gf",
        "package": "postcss-selector-parser",
        "affectedVersion": "6.1.4",
        "scope": "pnpm-lock.yaml",
        "severity": "moderate",
        "status": "not-affected",
        "basis": "unreachable",
        "reason": "Tailwind 3.4.1 (through postcss-nested) and @tailwindcss/typography 0.5.9 parse selectors only while building the library stylesheet from src/styles/index.css and class names in ./src. The published package does not depend on either parser, and runtime project content is never compiled as CSS. Trace and remediation: [docs/security/dependency-assessment-2026-10-09.md](docs/security/dependency-assessment-2026-10-09.md#addendum-2026-11-06-postcss-selector-parser-review).",
        "impact": "The advisory prerequisites are absent from the published packages and checked-in build/test callers; reassess when those callers change.",
        "evidence": "https://osv.dev/vulnerability/GHSA-rj75-hqrm-r3gf",
        "owner": "Claude",
        "reviewed": "2026-11-06",
        "expires": "2026-11-19"
      }
    ],
    "dependencyOverridePolicies": []
  }
}
