{
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "python.formatting.provider": "black",
  "files.exclude": {
    "**/abcde_env": true,
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": false,
    "**/forked": true,
  },
  "task.allowAutomaticTasks": "on",
  "terminal.integrated.automationProfile.windows": {
    "path": "cmd.exe"
  }
}
