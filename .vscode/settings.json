{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.turbo": true
  },
  "task.allowAutomaticTasks": "on",
  "terminal.integrated.automationProfile.windows": {
    "path": "cmd.exe"
  },
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".git",
    "**/venv",
    "**/.venv",
    "**/env",
    "**/.env",
    "**/site-packages",
    "**/.Python",
    "setta_files/code",
    "tests"
  ],
  "workbench.colorCustomizations": {
    "activityBar.background": "#402908",
    "titleBar.activeBackground": "#59390B",
    "titleBar.activeForeground": "#FDF9F3"
  }
}
