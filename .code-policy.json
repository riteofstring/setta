{
  "version": 3,
  "project": {
    "kind": "library",
    "capabilities": ["frontend", "ui"]
  },
  "scope": {
    "generated": ["docs/evidence/**/*.json", "docs/evidence/**/*.json.gz"],
    "entryPoints": [
      "apps/playground/vitest.setup.ts",
      "packages/workspace/tailwind-preset.mjs",
      "packages/workspace/tailwind.config.d.ts",
      "packages/workspace/vitest.setup.ts",
      "scripts/check-package-boundary.mjs",
      "scripts/check-workspace-policy.mjs",
      "scripts/compile-katex-styles.mjs",
      "scripts/profile-workspace-performance.mjs",
      "scripts/verify-packed-consumer.mjs"
    ],
    "development": [
      "apps/playground/**",
      "fixtures/**",
      "packages/workspace/tailwind.config.js",
      "packages/workspace/vite.config.ts",
      "packages/workspace/vitest.setup.ts",
      "scripts/**"
    ]
  },
  "quality": {},
  "portability": {},
  "modules": [
    {
      "name": "workspace",
      "paths": ["packages/workspace/**", "scripts/**", "fixtures/**"]
    },
    {
      "name": "playground",
      "paths": ["apps/playground/**"],
      "dependsOn": ["workspace"]
    }
  ],
  "checks": [
    {
      "name": "setta-package-contract",
      "provides": ["package-contract"],
      "argv": ["node", "scripts/check-package-boundary.mjs"],
      "modules": ["workspace", "playground"],
      "runOn": ["check", "gate"],
      "timeoutSeconds": 300
    },
    {
      "name": "workspace-build",
      "provides": ["build"],
      "argv": ["pnpm", "--filter", "@setta/workspace", "run", "build"],
      "modules": ["workspace"],
      "runOn": ["build"],
      "timeoutSeconds": 900
    },
    {
      "name": "playground-build",
      "provides": ["build"],
      "argv": ["pnpm", "--filter", "@setta/playground", "run", "build"],
      "modules": ["playground"],
      "runOn": ["build"],
      "timeoutSeconds": 900
    },
    {
      "name": "workspace-package-policy",
      "provides": ["workspace-policy"],
      "argv": ["node", "scripts/check-workspace-policy.mjs"],
      "modules": ["workspace", "playground"],
      "runOn": ["supply-chain"],
      "timeoutSeconds": 300
    }
  ],
  "tests": {
    "requiredKinds": ["component", "browser", "contract"],
    "suites": [
      {
        "name": "workspace-focused",
        "kind": "unit",
        "scope": "module",
        "cost": "quick",
        "modules": ["workspace"],
        "argv": [
          "pnpm",
          "--filter",
          "@setta/workspace",
          "exec",
          "vitest",
          "run",
          "src/publicApi.test.ts"
        ],
        "runOn": ["focused", "recommended", "full"],
        "timeoutSeconds": 300
      },
      {
        "name": "playground-focused",
        "kind": "component",
        "scope": "module",
        "cost": "quick",
        "modules": ["playground"],
        "argv": [
          "pnpm",
          "--filter",
          "@setta/playground",
          "exec",
          "vitest",
          "run",
          "src/hostToolbarControls.test.tsx"
        ],
        "runOn": ["focused", "recommended", "full"],
        "timeoutSeconds": 300
      },
      {
        "name": "workspace-component",
        "kind": "component",
        "scope": "module",
        "cost": "standard",
        "modules": ["workspace"],
        "argv": ["pnpm", "--filter", "@setta/workspace", "test"],
        "runOn": ["recommended", "full"],
        "timeoutSeconds": 1200
      },
      {
        "name": "playground-component",
        "kind": "component",
        "scope": "module",
        "cost": "standard",
        "modules": ["playground"],
        "argv": ["pnpm", "--filter", "@setta/playground", "test"],
        "runOn": ["recommended", "full"],
        "timeoutSeconds": 1200
      },
      {
        "name": "packed-consumer-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "expensive",
        "argv": ["pnpm", "run", "consumer:check"],
        "runOn": ["full"],
        "timeoutSeconds": 1800
      },
      {
        "name": "workspace-browser-profile",
        "kind": "browser",
        "scope": "repository",
        "cost": "expensive",
        "argv": ["pnpm", "run", "performance:profile", "--", "--passes", "1"],
        "runOn": ["full"],
        "timeoutSeconds": 1800
      }
    ]
  },
  "supplyChain": {
    "minimumReleaseAgeDays": 30,
    "auditLevel": "low",
    "allowedDependencyProtocols": ["workspace:"],
    "allowedLicenses": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "BlueOak-1.0.0",
      "CC0-1.0",
      "ISC",
      "MIT",
      "MIT-0",
      "MPL-2.0",
      "Python-2.0"
    ],
    "releaseAgeAssessments": [
      {
        "id": "nanoid-zero-size-security-fix",
        "ecosystem": "pnpm",
        "package": "nanoid",
        "version": "3.3.18",
        "scope": "pnpm-lock.yaml",
        "category": "security-fix",
        "evidence": "https://osv.dev/vulnerability/GHSA-2v37-7h3g-55p8",
        "reason": "This exact release fixes the high-severity infinite-loop vulnerability in the resolved nanoid 3.x line.",
        "owner": "workspace-extraction",
        "reviewed": "2026-08-16",
        "expires": "2026-09-06"
      }
    ],
    "vulnerabilityAssessments": [
      {
        "id": "undici-cache-private-directive-unreachable",
        "ecosystem": "pnpm",
        "advisory": "GHSA-4cwx-7wf7-3272",
        "package": "undici",
        "affectedVersion": "7.28.0",
        "scope": "pnpm-lock.yaml",
        "severity": "high",
        "status": "not-affected",
        "basis": "unreachable",
        "reason": "The vulnerable shared-cache parser is reachable only when undici interceptors.cache() is enabled; this repository has no undici imports or cache-interceptor configuration, and its dev-only jsdom setup installs no cache interceptor.",
        "impact": "No request can enter the affected shared-cache storage or parsing path, so cross-user disclosure and the cache-header crash are unreachable.",
        "evidence": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "tracking": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "owner": "workspace-extraction",
        "approvedBy": "kevin",
        "approval": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "reviewed": "2026-08-16",
        "expires": "2026-08-24"
      },
      {
        "id": "undici-retry-response-desync-unreachable",
        "ecosystem": "pnpm",
        "advisory": "GHSA-8xcm-r25x-g524",
        "package": "undici",
        "affectedVersion": "7.28.0",
        "scope": "pnpm-lock.yaml",
        "severity": "moderate",
        "status": "not-affected",
        "basis": "unreachable",
        "reason": "The vulnerable response-resume path requires undici interceptors.retry() and a proxy or gateway that forwards the resulting headers and body; this backend-free package and playground provide neither.",
        "impact": "No upstream response is retried and forwarded downstream, so a stale Content-Length value cannot desynchronize a consumer connection.",
        "evidence": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "tracking": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "owner": "workspace-extraction",
        "approvedBy": "kevin",
        "approval": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "reviewed": "2026-08-16",
        "expires": "2026-08-24"
      },
      {
        "id": "undici-cache-ows-directive-unreachable",
        "ecosystem": "pnpm",
        "advisory": "GHSA-jr45-8vmc-qm54",
        "package": "undici",
        "affectedVersion": "7.28.0",
        "scope": "pnpm-lock.yaml",
        "severity": "moderate",
        "status": "not-affected",
        "basis": "unreachable",
        "reason": "The vulnerable Cache-Control normalization path requires an explicitly enabled shared cache interceptor and authenticated upstream traffic; the repository configures neither undici caching nor upstream HTTP traffic.",
        "impact": "No authenticated response can be stored in or served from the affected undici shared cache, so cross-user disclosure is unreachable.",
        "evidence": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "tracking": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "owner": "workspace-extraction",
        "approvedBy": "kevin",
        "approval": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "reviewed": "2026-08-16",
        "expires": "2026-08-24"
      },
      {
        "id": "undici-blob-content-type-crlf-unreachable",
        "ecosystem": "pnpm",
        "advisory": "GHSA-m8rv-5g2x-5cg5",
        "package": "undici",
        "affectedVersion": "7.28.0",
        "scope": "pnpm-lock.yaml",
        "severity": "moderate",
        "status": "not-affected",
        "basis": "unreachable",
        "reason": "The vulnerable branch requires request(), stream(), pipeline(), or dispatch() with an attacker-controlled duck-typed blob body; repository code calls none of those APIs, and test File objects are native and never sent over the network.",
        "impact": "No attacker-controlled blob type reaches undici's HTTP/1.1 header construction, so CRLF header injection and request smuggling are unreachable.",
        "evidence": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "tracking": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "owner": "workspace-extraction",
        "approvedBy": "kevin",
        "approval": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "reviewed": "2026-08-16",
        "expires": "2026-08-24"
      },
      {
        "id": "undici-cookie-attribute-injection-unreachable",
        "ecosystem": "pnpm",
        "advisory": "GHSA-v3r7-h72x-cjcm",
        "package": "undici",
        "affectedVersion": "7.28.0",
        "scope": "pnpm-lock.yaml",
        "severity": "moderate",
        "status": "not-affected",
        "basis": "unreachable",
        "reason": "The vulnerable path requires passing attacker-controlled domain or unparsed fields to undici setCookie(); the repository has no undici cookie API calls and no backend cookie-writing surface.",
        "impact": "No untrusted cookie attribute reaches undici serialization, so SameSite, Secure, or HttpOnly attribute injection is unreachable.",
        "evidence": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "tracking": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "owner": "workspace-extraction",
        "approvedBy": "kevin",
        "approval": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "reviewed": "2026-08-16",
        "expires": "2026-08-24"
      },
      {
        "id": "postcss-source-map-read-unreachable",
        "ecosystem": "pnpm",
        "advisory": "GHSA-fxqj-rqcc-2cmp",
        "package": "postcss",
        "affectedVersion": "8.5.19",
        "scope": "pnpm-lock.yaml",
        "severity": "moderate",
        "status": "not-affected",
        "basis": "unreachable",
        "reason": "PostCSS is used only during development builds and tests on checked-in CSS; the repository's direct process() call supplies from, installed Vite supplies from, and no workflow accepts attacker-controlled CSS.",
        "impact": "No attacker-controlled sourceMappingURL is processed without a trusted base path or returned to an untrusted caller, so arbitrary .map-file reads and disclosure are unreachable.",
        "evidence": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "tracking": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "owner": "workspace-extraction",
        "approvedBy": "kevin",
        "approval": "https://github.com/riteofstring/setta/blob/workspace-extraction/docs/evidence/security/dependency-vulnerability-assessments-2026-08-16.md",
        "reviewed": "2026-08-16",
        "expires": "2026-08-24"
      }
    ]
  },
  "exceptions": [
    {
      "id": "playground-section-kinds-parity-length",
      "check": "quality.fileLength",
      "path": "apps/playground/src/sectionKinds.tsx",
      "subject": "1125",
      "reason": "The sealed formatter exposed this backend-free playground registry above the shared limit; component tests cover it while responsibility-based extraction is completed without changing playground behavior.",
      "owner": "workspace-extraction",
      "expires": "2026-08-20"
    },
    {
      "id": "zoom-pane-parity-owner-length",
      "check": "quality.fileLength",
      "path": "packages/workspace/src/canvas/ZoomPane.tsx",
      "subject": "1196",
      "reason": "This extracted interaction owner is protected by canvas unit, component, and browser checks; split it without changing frozen-reference behavior before expiry.",
      "owner": "workspace-extraction",
      "expires": "2026-08-20"
    },
    {
      "id": "key-activations-parity-test-length",
      "check": "quality.fileLength",
      "path": "packages/workspace/src/canvas/keyActivations.test.tsx",
      "subject": "2002",
      "reason": "The sealed formatter exposed this regression matrix above the test-file limit; the executable assertions remain intact while the fixture and scenario groups are split without reducing coverage.",
      "owner": "workspace-extraction",
      "expires": "2026-08-20"
    },
    {
      "id": "date-time-control-parity-length",
      "check": "quality.fileLength",
      "path": "packages/workspace/src/controls/date-time/DateTimeValueControl.tsx",
      "subject": "1116",
      "reason": "The sealed formatter exposed this accepted date-time interaction owner above the shared limit; its component suite protects behavior while calendar responsibilities are extracted before expiry.",
      "owner": "workspace-extraction",
      "expires": "2026-08-20"
    },
    {
      "id": "drop-type-parity-owner-length",
      "check": "quality.fileLength",
      "path": "packages/workspace/src/dnd/useDropType.ts",
      "subject": "1318",
      "reason": "This extracted drag-and-drop owner is protected by focused and browser interaction checks; split it without changing frozen-reference behavior before expiry.",
      "owner": "workspace-extraction",
      "expires": "2026-08-20"
    },
    {
      "id": "item-column-resize-pointer-parity",
      "check": "quality.lint",
      "path": "packages/workspace/src/items/ItemColumnResizeHandle.tsx",
      "subject": "jsx-a11y/no-static-element-interactions",
      "reason": "The accepted non-tab-stop divider preserves frozen pointer-drag and double-click behavior under focused component tests; keyboard resize semantics require a visible product interaction decision before changing this surface.",
      "owner": "workspace-extraction",
      "expires": "2026-08-20"
    },
    {
      "id": "item-row-dynamic-group-semantics",
      "check": "quality.lint",
      "path": "packages/workspace/src/items/ItemRow.tsx",
      "subject": "jsx-a11y/no-static-element-interactions",
      "reason": "The row becomes a named keyboard-operable group only in item-select mode and its dynamic role, tab stop, and key behavior are component-tested; the static lint rule cannot resolve that state-dependent contract.",
      "owner": "workspace-extraction",
      "expires": "2026-08-20"
    },
    {
      "id": "workspace-parity-stylesheet-length",
      "check": "quality.fileLength",
      "path": "packages/workspace/src/styles/workspace.css",
      "subject": "2040",
      "reason": "The scoped parity stylesheet is protected by accepted visual evidence and browser checks; split it by surface without redesigning styles before expiry.",
      "owner": "workspace-extraction",
      "expires": "2026-08-20"
    }
  ]
}
