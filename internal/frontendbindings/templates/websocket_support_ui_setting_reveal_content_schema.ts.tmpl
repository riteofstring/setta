{
  safeParse(value: unknown): SafeParseResult<UISettingRevealContent> {
    if (!websocketSupportIsRecord(value)) {
      return {
        success: false,
        error: {
          issues: ["Expected UISettingRevealContent object."],
        },
      };
    }

    const issues: Array<string> = [];
    const parsed: UISettingRevealContent = {
{{- range .LeadingStringFields }}
      {{ .PropertyName }}: {{ if .Optional }}websocketSupportReadOptionalString{{ else }}websocketSupportReadRequiredString{{ end }}(
        {{ .ValueExpr }},
        {{ .FieldPathExpr }},
        issues,
      ),
{{- end }}
      reveals: websocketSupportReadRevealTargets(value.reveals, issues),
      durationMs: websocketSupportReadDurationMs(value.durationMs, issues),
{{- range .TrailingStringFields }}
      {{ .PropertyName }}: {{ if .Optional }}websocketSupportReadOptionalString{{ else }}websocketSupportReadRequiredString{{ end }}(
        {{ .ValueExpr }},
        {{ .FieldPathExpr }},
        issues,
      ),
{{- end }}
    };

    if (issues.length > 0) {
      return {
        success: false,
        error: {
          issues,
        },
      };
    }

    return {
      success: true,
      data: parsed,
    };
  },
}
