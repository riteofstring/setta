{
  "name": "setta-workspace-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "api:report": "node scripts/generate-api-report.mjs",
    "build": "corepack pnpm build:package && corepack pnpm build:playground",
    "build:package": "corepack pnpm --filter @setta/workspace build",
    "build:playground": "corepack pnpm --filter @setta/workspace-playground build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:file-lengths": "node scripts/check-file-lengths.mjs --all",
    "consumer:check": "node scripts/verify-consumer.mjs",
    "dependency:inventory": "node scripts/generate-dependency-inventory.mjs",
    "dev": "corepack pnpm build:package && corepack pnpm --filter @setta/workspace-playground dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "node scripts/verify-package.mjs",
    "quality": "node scripts/quality.mjs",
    "quality:all": "node scripts/quality.mjs --all",
    "report:complexity": "node scripts/report-complexity.mjs",
    "report:file-lengths": "node scripts/report-file-lengths.mjs",
    "supply-chain:check": "node scripts/audit-supply-chain.mjs",
    "test": "corepack pnpm test:unit && corepack pnpm test:automation",
    "test:automation": "bash -n scripts/automation/codex-loop/run-plan-implementation-loop.sh scripts/automation/codex-loop/test_run_plan_implementation_loop.sh && bash scripts/automation/codex-loop/test_run_plan_implementation_loop.sh",
    "test:e2e": "playwright test",
    "test:unit": "vitest run && node --test scripts/check-boundaries.test.mjs",
    "typecheck": "tsc -p packages/workspace/tsconfig.json --pretty false && corepack pnpm run build:package && tsc -p apps/playground/tsconfig.json --pretty false && tsc -p tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "corepack": "0.35.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "knip": "6.31.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
