{
  "name": "setta-workspace-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "25.2.1"
  },
  "scripts": {
    "build": "pnpm --filter @setta/workspace run build",
    "consumer:check": "node scripts/verify-packed-consumer.mjs",
    "experiment-lens:playground": "python3 packages/setta-runtime/scripts/run_experiment_lens_playground.py",
    "performance:profile": "node scripts/profile-workspace-performance.mjs",
    "playground:inspect": "node scripts/inspect-playground.mjs",
    "realtime:playground": "python3 packages/setta-runtime/scripts/run_realtime_playground.py",
    "review:playground": "python3 packages/setta-runtime/scripts/run_review_playground.py",
    "workspace:browser:test": "node scripts/workspace-browser-interactions.mjs"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.6"
    }
  }
}
