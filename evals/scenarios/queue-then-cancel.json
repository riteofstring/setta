{
  "schemaVersion": 1,
  "id": "queue-then-cancel",
  "fixture": "typescript-service",
  "timeoutSeconds": 1800,
  "steps": [
    {
      "kind": "submit",
      "text": "Update request logging to include both the HTTP method and request path, add automated coverage, and run the relevant checks."
    },
    {
      "kind": "submit_when",
      "trigger": "agent_turn_running",
      "text": "After that, add GET /version returning the package version. This is a separate next task; do not interrupt the logging work for it."
    },
    {
      "kind": "submit_when",
      "trigger": "queue_nonempty",
      "text": "Cancel only the current logging task. Keep the queued /version task and continue with it."
    }
  ],
  "expect": {
    "terminalState": "completed",
    "clarification": "forbidden",
    "controlAssertions": [
      "follow_up_routed_through_director",
      "observed_run_cancelled",
      "no_mutation_after_cancel",
      "queued_request_present_once",
      "queued_request_promoted_once",
      "queued_request_completed_once",
      "queue_empty"
    ]
  },
  "verifier": "queue-then-cancel",
  "budget": {
    "hardTotalTokens": 400000
  },
  "communication": {
    "progress": "when_useful",
    "finalResultRequired": true
  }
}
