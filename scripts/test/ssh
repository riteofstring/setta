#!/usr/bin/env python3

import base64
import json
import os
import re
import select
import shlex
import socket
import sys
import threading
from datetime import datetime
from pathlib import Path
from typing import Any


SESSION_METADATA_FILENAME = "session.json"
SESSION_SECRET_FILENAME = "secret"
CONNECT_INFO_JSON_PREFIX = "__SETTA_JSON_B64__"


def _write_pid_file() -> None:
    pid_file = os.environ.get("SETTA_SSH_STUB_PID_FILE")
    if not pid_file:
        return
    try:
        Path(pid_file).write_text(f"{os.getpid()}\n", encoding="utf-8")
    except Exception:
        # Best-effort only.
        pass


def _append_command_log(command: str) -> None:
    command_log = os.environ.get("SETTA_SSH_STUB_COMMAND_LOG_FILE", "").strip()
    if not command_log:
        return
    try:
        normalized_command = _normalize_command_for_log(command)
        path = Path(command_log)
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(f"{normalized_command}\n")
    except Exception:
        # Best-effort only.
        pass


def _unwrap_shell_command(command: str) -> str:
    try:
        tokens = shlex.split(command)
    except ValueError:
        return command
    if len(tokens) >= 3 and tokens[1] == "-lc":
        return tokens[2]
    return command


def _normalize_command_for_log(command: str) -> str:
    inner = _unwrap_shell_command(command)
    try:
        return " ".join(shlex.split(inner))
    except ValueError:
        return inner


def _resolve_sessions_root() -> Path:
    sessions_root_raw = os.environ.get("SETTA_SESSIONS_ROOT", "").strip()
    if sessions_root_raw:
        sessions_root = Path(sessions_root_raw)
    else:
        workspace_root = os.environ.get("SETTA_WORKSPACE_ROOT", "").strip()
        if not workspace_root:
            raise RuntimeError(
                "SETTA_SESSIONS_ROOT (or SETTA_WORKSPACE_ROOT) must be set for ssh stub."
            )
        sessions_root = Path(workspace_root) / "setta_files" / "runtime" / "sessions"
    if not sessions_root.exists():
        raise RuntimeError(f"Sessions root does not exist: {sessions_root}")
    return sessions_root


def _load_all_sessions_metadata() -> list[tuple[str, dict[str, Any]]]:
    sessions_root = _resolve_sessions_root()
    sessions: list[tuple[str, dict[str, Any]]] = []
    for session_dir in sorted(sessions_root.iterdir()):
        if not session_dir.is_dir():
            continue
        metadata_path = session_dir / SESSION_METADATA_FILENAME
        secret_path = session_dir / SESSION_SECRET_FILENAME
        if not metadata_path.exists() or not secret_path.exists():
            continue
        try:
            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        except Exception:
            continue
        if not isinstance(metadata, dict):
            continue
        sessions.append((session_dir.name, metadata))
    return sessions


def _load_session_metadata(session_id_override: str | None = None) -> tuple[str, dict[str, Any], bytes]:
    session_id = (session_id_override or "").strip() or os.environ.get("SETTA_SESSION_ID", "").strip()
    sessions_root = _resolve_sessions_root()

    if not session_id:
        best: tuple[float, str, dict[str, Any]] | None = None
        for session_id_candidate, metadata in _load_all_sessions_metadata():
            started_at = metadata.get("startedAt")
            metadata_path = sessions_root / session_id_candidate / SESSION_METADATA_FILENAME
            score = metadata_path.stat().st_mtime
            if isinstance(started_at, str):
                try:
                    normalized = started_at.replace("Z", "+00:00")
                    score = datetime.fromisoformat(normalized).timestamp()
                except Exception:
                    pass
            if best is None or score > best[0]:
                best = (score, session_id_candidate, metadata)
        if best is None:
            raise RuntimeError(f"No sessions found under {sessions_root}")
        session_id = best[1]
        metadata = best[2]
    else:
        session_dir = sessions_root / session_id
        metadata_path = session_dir / SESSION_METADATA_FILENAME
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        if not isinstance(metadata, dict):
            raise RuntimeError("Session metadata is not a JSON object.")

    secret_path = sessions_root / session_id / SESSION_SECRET_FILENAME
    secret = secret_path.read_bytes()
    return session_id, metadata, secret


def _mint_bootstrap_token(session_id: str, secret: bytes) -> str:
    from setta.auth.manager import BOOTSTRAP_TOKEN_MANAGER

    return BOOTSTRAP_TOKEN_MANAGER.mint(session_id, secret)


def _build_bootstrap_urls(host: str, port: int, token: str) -> tuple[str, str]:
    from setta.utils.network import build_bootstrap_urls

    return build_bootstrap_urls(host, port, token)


def _emit_json(payload: dict[str, Any]) -> None:
    raw = json.dumps(payload, sort_keys=True).encode("utf-8")
    encoded = base64.b64encode(raw).decode("utf-8")
    sys.stdout.write(f"{CONNECT_INFO_JSON_PREFIX}{encoded}\n")


def _parse_forward_spec(value: str) -> tuple[int, str, int]:
    parts = value.split(":")
    if len(parts) != 3:
        raise ValueError(f"Invalid -L spec: {value}")
    local_port = int(parts[0])
    remote_host = parts[1]
    remote_port = int(parts[2])
    return local_port, remote_host, remote_port


def _proxy_stream(src: socket.socket, dest: socket.socket) -> None:
    try:
        while True:
            data = src.recv(65536)
            if not data:
                return
            dest.sendall(data)
    except OSError:
        return


def _handle_proxy(client: socket.socket, remote_host: str, remote_port: int) -> None:
    try:
        upstream = socket.create_connection((remote_host, remote_port), timeout=5.0)
    except OSError:
        client.close()
        return

    def _run() -> None:
        threads = [
            threading.Thread(
                target=_proxy_stream,
                args=(client, upstream),
                daemon=True,
            ),
            threading.Thread(
                target=_proxy_stream,
                args=(upstream, client),
                daemon=True,
            ),
        ]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join()

    try:
        _run()
    finally:
        try:
            client.close()
        finally:
            upstream.close()


def _run_port_forward(local_port: int, remote_host: str, remote_port: int) -> int:
    disable_forward_raw = os.environ.get("SETTA_SSH_STUB_DISABLE_FORWARD", "").strip()
    disable_forward = disable_forward_raw.lower() not in {"", "0", "false"}
    if disable_forward:
        # Tests sometimes want a "running" tunnel without exercising real socket
        # forwards (some sandboxes disallow binds). Simulate a long-lived tunnel
        # process that is terminated by SIGTERM/SIGINT.
        _write_pid_file()
        try:
            while True:
                # Sleep until killed.
                select.select([], [], [], 3600)
        except KeyboardInterrupt:
            return 0
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        server.bind(("127.0.0.1", local_port))
        server.listen(50)
    except OSError as exc:
        sys.stderr.write(f"ssh stub: failed to bind {local_port}: {exc}\n")
        return 1

    _write_pid_file()
    try:
        while True:
            client, _ = server.accept()
            thread = threading.Thread(
                target=_handle_proxy,
                args=(client, remote_host, remote_port),
                daemon=True,
            )
            thread.start()
    except KeyboardInterrupt:
        return 0
    finally:
        server.close()


def _extract_cd_path(command: str) -> str | None:
    inner = _unwrap_shell_command(command)
    try:
        tokens = shlex.split(inner)
    except ValueError:
        tokens = inner.split()
    for index, token in enumerate(tokens):
        if token == "cd" and index + 1 < len(tokens):
            candidate = tokens[index + 1].strip()
            if candidate:
                return candidate
    return None


def _extract_setta_files_location(command: str) -> str | None:
    inner = _unwrap_shell_command(command)
    try:
        tokens = shlex.split(inner)
    except ValueError:
        tokens = inner.split()
    for index, token in enumerate(tokens):
        if token == "--setta-files-location" and index + 1 < len(tokens):
            candidate = tokens[index + 1].strip().lower()
            if candidate in {"auto", "local", "global"}:
                return candidate
        if token.startswith("--setta-files-location="):
            candidate = token.split("=", 1)[1].strip().lower()
            if candidate in {"auto", "local", "global"}:
                return candidate
    return None


def _extract_launcher_origin(command: str) -> str | None:
    candidate: str | None = None
    inner = _unwrap_shell_command(command)
    try:
        tokens = shlex.split(inner)
    except ValueError:
        tokens = inner.split()
    for index, token in enumerate(tokens):
        if token == "--launcher-origin" and index + 1 < len(tokens):
            candidate = tokens[index + 1]
            break
        if token.startswith("--launcher-origin="):
            candidate = token.split("=", 1)[1]
            break
    if candidate is None:
        match = re.search(
            r"launcher-origin[^A-Za-z0-9]*(https?://[^\s'\";&]+)",
            inner,
        )
        if match:
            candidate = match.group(1)
    if candidate is None:
        return None
    try:
        from setta.utils.launcher_origin_handoff import normalize_launcher_origin

        return normalize_launcher_origin(candidate)
    except Exception:
        return None


def _extract_session_id(command: str) -> str | None:
    inner = _unwrap_shell_command(command)
    try:
        tokens = shlex.split(inner)
    except ValueError:
        tokens = inner.split()
    for index, token in enumerate(tokens):
        if token == "--session" and index + 1 < len(tokens):
            candidate = tokens[index + 1].strip()
            if candidate:
                return candidate
        if token == "--delete-session" and index + 1 < len(tokens):
            candidate = tokens[index + 1].strip()
            if candidate:
                return candidate
        if token.startswith("--session="):
            candidate = token.split("=", 1)[1].strip()
            if candidate:
                return candidate
        if token.startswith("--delete-session="):
            candidate = token.split("=", 1)[1].strip()
            if candidate:
                return candidate
    match = re.search(r"delete-session[^A-Za-z0-9_-]*([A-Za-z0-9_-]+)", inner)
    if match:
        candidate = match.group(1).strip()
        if candidate:
            return candidate
    return None


def _extract_server_mode(command: str) -> str | None:
    inner = _unwrap_shell_command(command)
    try:
        tokens = shlex.split(inner)
    except ValueError:
        tokens = inner.split()
    for index, token in enumerate(tokens):
        if token == "--server-mode" and index + 1 < len(tokens):
            candidate = tokens[index + 1].strip().lower()
            if candidate:
                return candidate
        if token.startswith("--server-mode="):
            candidate = token.split("=", 1)[1].strip().lower()
            if candidate:
                return candidate
    return None


def _start_marker_path() -> Path | None:
    raw = os.environ.get("SETTA_SSH_STUB_START_MARKER_FILE", "").strip()
    if not raw:
        return None
    return Path(raw)


def _no_sessions_before_start() -> bool:
    raw = os.environ.get("SETTA_SSH_STUB_NO_SESSIONS_BEFORE_START", "").strip().lower()
    return raw not in {"", "0", "false"}


def _handle_remote_command(command: str) -> int:
    command = command.strip()
    _append_command_log(command)
    debug_commands_raw = os.environ.get("SETTA_SSH_STUB_DEBUG_COMMANDS", "").strip()
    if debug_commands_raw.lower() not in {"", "0", "false"}:
        sys.stderr.write(f"ssh stub command: {command}\n")

    if command.startswith("command -v "):
        tool = command.split()[-1].strip().strip("'\"")
        # Pretend common tools exist; return 1 for unknown names to match `command -v`.
        known = {
            "bash": "/bin/bash",
            "sh": "/bin/sh",
            "setsid": "/usr/bin/setsid",
            "nohup": "/usr/bin/nohup",
            "setta": "/usr/local/bin/setta",
            "poetry": "/usr/local/bin/poetry",
            "uv": "/usr/local/bin/uv",
        }
        path = known.get(tool)
        if not path:
            return 1
        sys.stdout.write(f"{path}\n")
        return 0

    if "pwd -P" in command:
        cd_path = _extract_cd_path(command) or "/tmp"
        sys.stdout.write(f"{cd_path}\n")
        return 0

    if "status --list-sessions" in command and "--json" in command:
        marker_path = _start_marker_path()
        if _no_sessions_before_start() and marker_path is not None and not marker_path.exists():
            _emit_json({"sessions": []})
            return 0
        requested_server_mode = _extract_server_mode(command)
        sessions_payload: list[dict[str, Any]] = []
        for session_id, metadata in _load_all_sessions_metadata():
            server_mode = str(metadata.get("serverMode", "ide")).strip().lower() or "ide"
            if requested_server_mode is not None and server_mode != requested_server_mode:
                continue
            sessions_payload.append(
                {
                    "id": metadata.get("id", session_id),
                    "workspacePath": metadata.get("workspacePath", "/tmp/workspace"),
                    "workspacePathCanonical": metadata.get(
                        "workspacePathCanonical", "/tmp/workspace"
                    ),
                    "host": metadata.get("host", "127.0.0.1"),
                    "port": int(metadata.get("port", 8000)),
                    "pid": int(metadata.get("pid", 0)),
                    "startedAt": metadata.get("startedAt", "2026-02-06T00:00:00Z"),
                    "serverMode": server_mode,
                }
            )
        payload = {"sessions": sessions_payload}
        _emit_json(payload)
        return 0

    if "status --delete-session" in command:
        session_id = _extract_session_id(command)
        if not session_id:
            sys.stderr.write("ssh stub: missing session id for delete\n")
            return 2
        sessions_root_raw = os.environ.get("SETTA_SESSIONS_ROOT", "").strip()
        if not sessions_root_raw:
            sys.stderr.write("ssh stub: missing SETTA_SESSIONS_ROOT for delete\n")
            return 2
        session_dir = Path(sessions_root_raw) / session_id
        if session_dir.exists():
            for child in sorted(session_dir.rglob("*"), reverse=True):
                try:
                    if child.is_file() or child.is_symlink():
                        child.unlink()
                    elif child.is_dir():
                        child.rmdir()
                except OSError:
                    pass
            try:
                session_dir.rmdir()
            except OSError:
                pass
        return 0

    if "status --connect-info" in command and "--json" in command:
        session_id, metadata, secret = _load_session_metadata(_extract_session_id(command))
        token = _mint_bootstrap_token(session_id, secret)
        host = str(metadata.get("host", "127.0.0.1"))
        port = int(metadata.get("port", 8000))
        bootstrap_url_fragment, bootstrap_url_plain = _build_bootstrap_urls(
            host, port, token
        )
        runtime_root = os.environ.get("SETTA_RUNTIME_ROOT", "").strip()
        requested_location = _extract_setta_files_location(command)
        env_location = os.environ.get("SETTA_FILES_LOCATION", "").strip().lower()
        if env_location not in ("auto", "local", "global"):
            env_location = ""
        candidate_location = requested_location or env_location or "auto"

        cd_path = _extract_cd_path(command) or os.environ.get("SETTA_WORKSPACE_ROOT", "").strip() or "/tmp"
        has_local_root = False
        try:
            has_local_root = (Path(cd_path) / "setta_files").is_dir()
        except Exception:
            has_local_root = False

        if has_local_root:
            resolved_location = "local"
        elif candidate_location in ("local", "global"):
            resolved_location = candidate_location
        elif env_location in ("local", "global"):
            resolved_location = env_location
        else:
            resolved_location = "local"
        payload = {
            "session": {
                "id": metadata.get("id", session_id),
                "workspacePath": metadata.get("workspacePath", "/tmp/workspace"),
                "workspacePathCanonical": metadata.get(
                    "workspacePathCanonical", "/tmp/workspace"
                ),
                "host": host,
                "port": port,
                "pid": int(metadata.get("pid", 0)),
                "startedAt": metadata.get("startedAt", "2026-02-06T00:00:00Z"),
                "serverMode": metadata.get("serverMode", "ide"),
            },
            "bootstrapUrlFragment": bootstrap_url_fragment,
            "bootstrapUrlPlain": bootstrap_url_plain,
            "sshTunnelCommand": "ssh -N -L ${LOCAL_PORT}:127.0.0.1:1234 user@host -o ExitOnForwardFailure=yes",
            "settaFilesLocation": resolved_location,
            "runtimeRoot": runtime_root or None,
        }
        requested_launcher_origin = _extract_launcher_origin(command)
        if requested_launcher_origin is not None:
            try:
                from setta.utils.launcher_origin_handoff import (
                    mint_launcher_origin_handoff_proof,
                )

                payload["launcherOrigin"] = requested_launcher_origin
                payload["launcherOriginProof"] = mint_launcher_origin_handoff_proof(
                    session_id=session_id,
                    launcher_origin=requested_launcher_origin,
                    secret=secret,
                )
            except Exception:
                pass
        _emit_json(payload)
        return 0

    if "--no-open" in command:
        marker_path = _start_marker_path()
        if marker_path is not None:
            marker_path.parent.mkdir(parents=True, exist_ok=True)
            marker_path.write_text("started\n", encoding="utf-8")
        return 0

    # Remote Setta command resolver prints a command string to stdout.
    if "printf" in command and "setta" in command:
        sys.stdout.write("setta\n")
        return 0

    sys.stderr.write(f"ssh stub: unhandled remote command: {command}\n")
    return 2


def main(argv: list[str]) -> int:
    if "-N" in argv and "-L" in argv:
        try:
            idx = argv.index("-L")
            spec = argv[idx + 1]
        except Exception as exc:
            sys.stderr.write(f"ssh stub: invalid -L args: {exc}\n")
            return 2
        local_port, remote_host, remote_port = _parse_forward_spec(spec)
        # The real SSH client supports IPv6 bracket notation; our forwarder expects raw host.
        if remote_host.startswith("[") and remote_host.endswith("]"):
            remote_host = remote_host[1:-1]
        return _run_port_forward(local_port, remote_host, remote_port)

    if len(argv) < 2:
        sys.stderr.write("ssh stub: missing target/command\n")
        return 2

    remote_command = argv[-1]
    return _handle_remote_command(remote_command)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
