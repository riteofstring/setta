{
  "manifest_version": 3,
  "name": "Setta Chrome Repro Recorder",
  "version": "0.0.1",
  "description": "Records browser interactions for Setta repro capture.",
  "permissions": ["<all_urls>", "activeTab", "debugger", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["pageRuntime.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Setta Chrome Repro Recorder"
  }
}
