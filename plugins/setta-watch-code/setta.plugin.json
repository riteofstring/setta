{
  "schemaVersion": 1,
  "id": "setta-watch-code",
  "name": "Setta Watch Code",
  "version": "0.1.0",
  "settaVersionRange": ">=0.0.0",
  "enabledByDefault": true,
  "frontend": {
    "entrypoint": "frontend/dist/index.js",
    "build": {
      "packageManager": "pnpm"
    }
  },
  "featureCapabilities": {
    "watchCode": {
      "python": true,
      "requiresLanguageServer": true,
      "canvasControlsUi": true
    }
  },
  "capabilities": [
    "registerCanvasControl",
    "readProjectState",
    "subscribeProjectState"
  ]
}
