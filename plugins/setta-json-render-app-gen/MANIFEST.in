include build_backend.py
include pyproject.toml
include README.md
include setta.plugin.json
include frontend/.npmrc
include frontend/package.json
include frontend/tsconfig.json
include frontend/tsconfig.typecheck.json
include frontend/vite.config.mjs
include frontend/vitest.config.mjs
graft runtime_backend
graft frontend/scripts
graft frontend/src
graft frontend/tests
graft frontend/typecheck
graft frontend/vendor
prune frontend/dist
prune frontend/node_modules
global-exclude __pycache__
global-exclude *.py[cod]
