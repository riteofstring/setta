{
  "name": "@setta/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./tailwind-preset.mjs"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tailwindcss -c tailwind.config.js -i src/styles/index.css -o dist/styles.css && node ../../scripts/check-package-boundary.mjs --built",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.2.4",
    "@dnd-kit/dom": "0.2.4",
    "@dnd-kit/geometry": "0.2.4",
    "@dnd-kit/react": "0.2.4",
    "@dnd-kit/state": "0.2.4",
    "classcat": "5.0.3",
    "d3-drag": "3.0.0",
    "d3-interpolate": "3.0.1",
    "d3-selection": "3.0.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "lodash": "4.18.1",
    "re-resizable": "6.10.3",
    "react-icons": "5.3.0",
    "use-sync-external-store": "1.6.0",
    "zustand": "5.0.8"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/d3-drag": "3.0.7",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-selection": "3.0.11",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.8",
    "@types/lodash": "4.17.17",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.8",
    "jsdom": "28.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "3.4.1",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
