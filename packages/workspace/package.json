{
  "name": "@riteofstring/setta",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./tailwind-preset.mjs",
    "./browser": {
      "types": "./dist/types/browser/index.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src/canvas/LICENSE",
    "src/dnd/LICENSE",
    "tailwind-preset.mjs",
    "LICENSE",
    "BROWSER.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tailwindcss -c tailwind.config.js -i src/styles/index.css -o dist/styles.css && node ../../scripts/compile-katex-styles.mjs && node ../../scripts/check-package-boundary.mjs --built && pnpm pack --out setta.tgz",
    "test": "vitest run"
  },
