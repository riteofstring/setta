{
  "schemaVersion": 1,
  "defaultProvider": "hetzner",
  "shapes": [
    {
      "id": "dev-small",
      "label": "Dev small",
      "guide": "2 vCPU / 4-8 GB RAM",
      "cpuMin": 2,
      "memoryGbMin": 4,
      "diskFloorGb": 64
    },
    {
      "id": "dev-standard",
      "label": "Dev standard",
      "guide": "4 vCPU / 16 GB RAM",
      "cpuMin": 4,
      "memoryGbMin": 16,
      "diskFloorGb": 64
    },
    {
      "id": "dev-large",
      "label": "Dev large",
      "guide": "8+ vCPU / 32 GB RAM",
      "cpuMin": 8,
      "memoryGbMin": 32,
      "diskFloorGb": 64
    },
    {
      "id": "gpu-small",
      "label": "GPU small",
      "guide": "entry GPU class for inference or light fine-tuning",
      "cpuMin": 4,
      "memoryGbMin": 16,
      "gpuClass": "entry",
      "diskFloorGb": 128
    },
    {
      "id": "gpu-large",
      "label": "GPU large",
      "guide": "A100/H100 class GPU for serious model work",
      "cpuMin": 8,
      "memoryGbMin": 64,
      "gpuClass": "large",
      "diskFloorGb": 128
    }
  ],
  "providers": [
    {
      "id": "hetzner",
      "displayName": "Hetzner Cloud",
      "pricingUrl": "https://www.hetzner.com/cloud",
      "cli": {
        "binary": "hcloud",
        "versionArgs": ["version"],
        "authProbeArgs": ["context", "active"],
        "liveResolveArgs": ["server-type", "list", "-o", "json"]
      },
      "regionPreferences": ["fsn1", "nbg1", "hel1"],
      "imageSelector": {
        "kind": "image_alias",
        "value": "ubuntu-24.04",
        "description": "Hetzner stable Ubuntu 24.04 image alias"
      },
      "mappings": {
        "dev-small": {
          "instanceType": "cx22",
          "costClass": "low"
        },
        "dev-standard": {
          "instanceType": "cx42",
          "costClass": "standard"
        }
      }
    },
    {
      "id": "aws",
      "displayName": "AWS",
      "pricingUrl": "https://aws.amazon.com/ec2/pricing/on-demand/",
      "cli": {
        "binary": "aws",
        "versionArgs": ["--version"],
        "authProbeArgs": ["sts", "get-caller-identity", "--output", "json"]
      },
      "regionPreferences": ["us-east-1", "us-west-2", "eu-west-1"],
      "imageSelector": {
        "kind": "aws_ssm_ubuntu_lts",
        "value": "ubuntu-24.04-lts",
        "description": "Resolve the latest Canonical Ubuntu LTS AMI from AWS public SSM parameters in the selected region"
      },
      "mappings": {
        "dev-small": {
          "instanceType": "t3.medium",
          "costClass": "low"
        },
        "dev-standard": {
          "instanceType": "t3.xlarge",
          "costClass": "standard"
        },
        "dev-large": {
          "instanceType": "t3.2xlarge",
          "costClass": "large"
        },
        "gpu-small": {
          "instanceType": "g4dn.xlarge",
          "costClass": "gpu-entry",
          "gpuClass": "entry"
        },
        "gpu-large": {
          "instanceType": "p4d.24xlarge",
          "costClass": "gpu-large",
          "gpuClass": "large"
        }
      }
    },
    {
      "id": "gcp",
      "displayName": "Google Cloud",
      "pricingUrl": "https://cloud.google.com/products/compute/pricing",
      "cli": {
        "binary": "gcloud",
        "versionArgs": ["version", "--format=json"],
        "authProbeArgs": ["auth", "list", "--filter=status:ACTIVE", "--format=json(account)"]
      },
      "regionPreferences": ["us-central1", "us-east1", "europe-west1"],
      "imageSelector": {
        "kind": "gcp_image_family",
        "value": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64",
        "description": "Resolve the current Ubuntu 24.04 LTS image from the ubuntu-os-cloud image family"
      },
      "mappings": {
        "dev-small": {
          "instanceType": "e2-medium",
          "costClass": "low"
        },
        "dev-standard": {
          "instanceType": "e2-standard-4",
          "costClass": "standard"
        },
        "dev-large": {
          "instanceType": "e2-standard-8",
          "costClass": "large"
        },
        "gpu-small": {
          "instanceType": "g2-standard-4",
          "costClass": "gpu-entry",
          "gpuClass": "entry"
        },
        "gpu-large": {
          "instanceType": "a2-highgpu-1g",
          "costClass": "gpu-large",
          "gpuClass": "large"
        }
      }
    },
    {
      "id": "digitalocean",
      "displayName": "DigitalOcean",
      "pricingUrl": "https://www.digitalocean.com/pricing/droplets",
      "cli": {
        "binary": "doctl",
        "versionArgs": ["version"],
        "authProbeArgs": ["account", "get", "--output", "json"]
      },
      "regionPreferences": ["nyc3", "sfo3", "fra1"],
      "imageSelector": {
        "kind": "image_slug",
        "value": "ubuntu-24-04-x64",
        "description": "DigitalOcean Ubuntu 24.04 LTS x64 image slug"
      },
      "mappings": {
        "dev-small": {
          "instanceType": "s-2vcpu-4gb",
          "costClass": "low"
        },
        "dev-standard": {
          "instanceType": "s-4vcpu-16gb",
          "costClass": "standard"
        },
        "dev-large": {
          "instanceType": "s-8vcpu-32gb",
          "costClass": "large"
        }
      }
    },
    {
      "id": "paperspace",
      "displayName": "Paperspace",
      "pricingUrl": "https://www.paperspace.com/pricing",
      "regionPreferences": ["ny2", "ca1", "ams1"],
      "imageSelector": {
        "kind": "template_family",
        "value": "Ubuntu 22.04 LTS",
        "description": "Paperspace Linux Ubuntu LTS machine template"
      },
      "mappings": {
        "dev-small": {
          "instanceType": "C4",
          "costClass": "low"
        },
        "dev-standard": {
          "instanceType": "C6",
          "costClass": "standard"
        },
        "gpu-small": {
          "instanceType": "A4000",
          "costClass": "gpu-entry",
          "gpuClass": "entry"
        },
        "gpu-large": {
          "instanceType": "A100-80G",
          "costClass": "gpu-large",
          "gpuClass": "large"
        }
      }
    }
  ]
}
