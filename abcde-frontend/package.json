{
  "name": "abcde-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "6.0.5",
    "@dnd-kit/modifiers": "6.0.0",
    "@dnd-kit/sortable": "7.0.1",
    "@emotion/react": "11",
    "@emotion/styled": "11",
    "@fontsource/inter": "4.5.7",
    "@fontsource/jetbrains-mono": "4.5.10",
    "@fontsource/work-sans": "4.5.7",
    "@monaco-editor/react": "4.0.10",
    "@radix-ui/react-collapsible": "1.0.1",
    "@radix-ui/react-dialog": "1.0.2",
    "@radix-ui/react-dropdown-menu": "1.0.0",
    "@radix-ui/react-popover": "1.0.2",
    "@radix-ui/react-radio-group": "1.1.0",
    "@radix-ui/react-slider": "1.1.0",
    "@radix-ui/react-switch": "1.0.1",
    "@radix-ui/react-tabs": "1.0.1",
    "@vitejs/plugin-react": "2.1.0",
    "ansi-colors": "4.1.1",
    "autoprefixer": "10.4.12",
    "axios": "0.21.0",
    "downshift": "6.1.0",
    "formik": "2.2.6",
    "framer-motion": "4.1.17",
    "immer": "9.0.16",
    "lodash": "4.17.21",
    "match-sorter": "6.3.1",
    "postcss": "8.4.18",
    "re-resizable": "6.9.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-flow-renderer": "10.2.2",
    "react-icons": "4.2.0",
    "tailwindcss": "3.2.4",
    "use-deep-compare-effect": "1.8.1",
    "vite": "3.1.7",
    "vite-plugin-svgr": "2.2.1",
    "vite-tsconfig-paths": "3.5.1",
    "web-vitals": "2.1.0",
    "yup": "0.32.8",
    "zustand": "4.1.4"
  },
  "scripts": {
    "start": "vite",
    "sna": "vite --mode sna",
    "snancm": "vite --mode snancm",
    "build": "tsc && vite build",
    "test": "yarn vitest --mode sna",
    "serve": "vite preview",
    "l": "yarn eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "f": "yarn prettier src --write",
    "lf": "yarn l && yarn f",
    "linkutils": "cd ../abcde-utils && git pull && yarn && yarn link && cd ../abcde-frontend && yarn link abcde-utils",
    "linktest": "cd ../abcde-test && git pull && yarn && yarn link && cd ../abcde-frontend && yarn link abcde-test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "5.16.4",
    "@testing-library/react": "13.3.0",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.2.1",
    "@types/babel__generator": "7.6.4",
    "babel-eslint": "10.1.0",
    "eslint": "7.32.0",
    "eslint-import-resolver-custom-alias": "1.3.0",
    "eslint-plugin-import": "2.25.4",
    "eslint-plugin-react": "7.31.10",
    "eslint-plugin-unused-imports": "1.1.5",
    "jsdom": "20.0.1",
    "prettier": "2.4.1",
    "prettier-plugin-organize-imports": "3.0.0",
    "typescript": "4.7.4",
    "vitest": "0.24.5"
  }
}
