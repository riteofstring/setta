    "eslint-plugin-unused-imports": "1.1.5",
    "jsdom": "20.0.1",
    "knip": "3.8.4",
    "prettier": "2.8.3",
    "prettier-plugin-organize-imports": "3.0.0",
    "prettier-plugin-tailwindcss": "0.2.2",
    "ts-prune": "0.10.3",
