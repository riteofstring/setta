  "scripts": {
    "start": "concurrently --kill-others \"vite\" \"bash ./backendStart.sh\"",
    "startr": "concurrently --kill-others \"vite\" \"bash ./backendStart.sh --reload\"",
    "ncm": "concurrently --kill-others \"vite --mode ncm\" \"bash ./backendStart.sh\"",
    "ncmr": "concurrently --kill-others \"vite --mode ncm\" \"bash ./backendStart.sh --reload\"",
    "reset": "cd .. && rm -f runcoder.db && cd frontend && yarn start",
    "build": "vite build --base=/static/",
    "test": "yarn vitest",
    "serve": "vite preview",
    "l": "yarn eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "f": "yarn prettier src --write",
    "lf": "yarn l && yarn f",
    "knip": "knip",
    "ts-prune": "ts-prune"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "5.16.4",
    "@testing-library/react": "13.3.0",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.2.1",
