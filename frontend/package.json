{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "concurrently --kill-others \"cd runcoder && pnpm start\" \"bash runcoder/backendStart.sh\"",
    "startr": "concurrently --kill-others \"cd runcoder && pnpm start\" \"bash runcoder/backendStart.sh --reload\"",
    "ncm": "concurrently --kill-others \"cd runcoder && pnpm ncm\" \"bash runcoder/backendStart.sh\"",
    "ncmr": "concurrently --kill-others \"cd runcoder && pnpm ncm\" \"bash runcoder/backendStart.sh --reload\"",
    "reset": "cd .. && rm -f runcoder.db && cd frontend && pnpm start",
    "build": "cd runcoder && pnpm build",
    "test": "vitest",
    "serve": "vite preview",
    "l": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "f": "prettier src --write",
    "lf": "pnpm l && pnpm f",
    "knip": "knip",
    "ts-prune": "ts-prune",
    "cleaninstall": "rm -rf node_modules **/node_modules && pnpm install"
  },
  "devDependencies": {
    "concurrently": "8.2.0"
  }
}
