  "scripts": {
    "start": "concurrently --kill-others \"vite\" \"bash ./backendStart.sh\"",
    "startr": "concurrently --kill-others \"vite\" \"bash ./backendStart.sh --reload\"",
    "ncm": "concurrently --kill-others \"vite --mode ncm\" \"bash ./backendStart.sh\"",
    "ncmr": "concurrently --kill-others \"vite --mode ncm\" \"bash ./backendStart.sh --reload\"",
    "reset": "cd .. && ROOT_DIR=$(pwd) && ./scripts/reset-setta-state.sh --workspace \"$ROOT_DIR\" && cd frontend && pnpm start",
    "aireset": "cd .. && ./aireset.sh",
    "build": "vite build --base=/static/",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview",
    "l": "bash ./scripts/eslint_sources.sh",
    "f": "bash ./scripts/format_sources.sh",
    "lf": "pnpm l && pnpm f",
    "run-knip": "node ./scripts/runKnip.mjs",
    "prune-python": "cd .. && . ./activate.sh && python backend/scripts/prune_generated_types.py && ./format_code.sh",
    "full-cleanup": "pnpm run-knip && pnpm prune-python",
    "gcf": "bash ./scripts/gcf.sh",
    "gcft": "pnpm gcf && cd .. && ./t.sh",
    "postinstall": "rm -rf node_modules/.vite && node ./scripts/fix_xterm.mjs",
    "cleaninstall": "rm -rf node_modules dist pnpm-lock.yaml && pnpm install",
    "generate": "bash ./generation/generate.sh",
    "generate-go-frontend-bindings": "bash ./generation/generate_go_frontend_bindings.sh",
    "generate-http-openapi-bindings": "bash ./generation/generate_http_openapi_bindings.sh",
    "generate-go-python-types": "bash ./generation/generate_go_python_types.sh",
    "cdp-port": "cd .. && ./scripts/cdp-port.sh",
    "worktree": "cd .. && ./worktree.sh",
    "worktrees": "cd .. && ./worktree.sh",
    "ai": "cd .. && ./ai.sh",
    "kill": "cd .. && ./kill.sh"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "pnpm": {
    "overrides": {
      "defu@^6.1.4": "6.1.7",
      "flatted@^3.2.9": "3.4.2",
