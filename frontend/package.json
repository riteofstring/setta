    "xterm-addon-fit": "0.8.0",
    "zod": "4.1.3",
    "zustand": "5.0.8"
  },
  "scripts": {
    "start": "concurrently --kill-others \"vite\" \"bash ./backendStart.sh\"",
    "startr": "concurrently --kill-others \"vite\" \"bash ./backendStart.sh --reload\"",
    "ncm": "concurrently --kill-others \"vite --mode ncm\" \"bash ./backendStart.sh\"",
    "ncmr": "concurrently --kill-others \"vite --mode ncm\" \"bash ./backendStart.sh --reload\"",
    "reset": "cd .. && rm -rf setta_files && cd frontend && pnpm start",
    "aireset": "cd .. && rm -rf setta_files && ./scripts/ai.sh",
    "build": "vite build --base=/static/",
    "test": "vitest",
    "serve": "vite preview",
    "l": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "f": "prettier src --write",
    "lf": "pnpm l && pnpm f",
    "run-knip": "node ./scripts/runKnip.mjs",
    "prune-python": "cd .. && . ./activate.sh && python backend/scripts/prune_generated_types.py && ./format_code.sh",
    "full-cleanup": "pnpm run-knip && pnpm prune-python",
    "gcf": "pnpm generate && pnpm full-cleanup && pnpm f",
    "gcft": "pnpm gcf && cd .. && ./run_tests.sh",
    "postinstall": "rm -rf node_modules/.vite && python fix_xterm.py",
    "cleaninstall": "rm -rf node_modules dist pnpm-lock.yaml && pnpm install",
    "generate": "bash ./generation/generate.sh",
    "cdp-port": "cd .. && ./scripts/cdp-port.sh",
    "ai": "cd .. && ./scripts/ai.sh",
    "aicdt": "cd .. && ./scripts/aicdt.sh",
    "kill": "cd .. && ./scripts/kill-setta.sh"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/d3": "7.4.3",
    "@types/lodash": "4.17.17",
    "@types/node": "25.0.2",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.8",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.26.0",
    "@typescript-eslint/parser": "8.26.0",
    "concurrently": "8.2.0",
    "eslint": "9.21.0",
    "eslint-plugin-react": "7.37.4",
    "knip": "5.73.4",
    "oxlint": "1.33.0",
    "playwright": "1.57.0",
    "prettier": "3.2.4",
    "prettier-plugin-organize-imports": "3.2.4",
    "prettier-plugin-tailwindcss": "0.5.11",
    "react-scan": "0.4.3",
    "remove-unused-vars": "0.0.11",
    "typescript": "5.8.3",
    "vitest": "2.1.8"
  }
}
