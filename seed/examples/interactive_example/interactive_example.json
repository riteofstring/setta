    "8055d10b-3623-4665-b85c-977327fa40c6": {
      "selectedItem": null,
      "codeInfoColId": "75cdb9b3-a7c8-4fd8-8da6-9667a65fea48",
      "values": {},
      "children": [],
      "name": "involved_red",
      "code": "from setta.tasks.fns import InteractiveTaskDefinition\nimport base64\nfrom io import BytesIO\nfrom PIL import Image, ImageFilter\n\ndef decode_img(base64_img):\n    image_data = base64.b64decode(base64_img)\n    return Image.open(BytesIO(image_data))\n\ndef encode_img(img):\n    buffered = BytesIO()\n    img.save(buffered, format=\"png\")\n    return base64.b64encode(buffered.getvalue()).decode('utf-8')    \n\n\n\ndef fn(message):\n    data = message.content\n    blur_radius = float(data[\"blur_radius\"])\n    img = data[\"royal_orange\"][0][\"value\"]\n    img = decode_img(img)\n    img = img.filter(ImageFilter.GaussianBlur(radius=blur_radius))\n    img = encode_img(img)\n    return {\"content\": [{\"value\": img, \"type\": \"img\", \"displayName\": \"blurredImg\"}]}\n\n\ninteractive_example = InteractiveTaskDefinition(fn=fn)",
      "keywordPositions": [],
      "isFrozen": false,
      "isDefault": true,
      "description": "",
      "sweep": [],
      "runGroup": {}
    },
    "91b7814e-8f93-4ad1-a966-00851b4e41d9": {
      "selectedItem": null,
      "codeInfoColId": "2f3d4196-b243-4186-919f-163dc203ca5a",
      "values": {},
      "children": [],
      "name": "victorious_white",
      "code": "from setta.tasks.fns import InteractiveTaskDefinition\n\ndef fn(message):\n    data = message.content\n    c = float(data[\"c\"])\n    n = int(data[\"n\"])\n    value = [((i - 10) / 5) ** c for i in range(n)]\n    return_content = {\"value\": value, \"type\": \"list\", \"displayName\": \"Fancy Graph\"}\n    return {\"content\": [return_content]}\n\n\ninteractive_example = InteractiveTaskDefinition(fn=fn)",
