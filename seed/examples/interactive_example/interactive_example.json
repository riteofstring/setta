    "56218716-8dc7-4a8b-a253-1eb2bb9cfc56": {
      "name": "ratty_red",
      "code": "$SETTA_GENERATED_PYTHON\n\nfrom setta.cli.logger import Setta, SettaImg\nimport numpy as np\n\n\ns = Setta()\n\nimg = np.random.randint(low=0, high=256, size=(100, 100, 3), dtype=np.uint8)\ns.log({\"test_folder/another_folder/img\": SettaImg(img)}, save=True)\n\n# c = 3\n# losses = [((i - 10) / 5) ** float(c) for i in range(n)]\n# s.log({\"test_folder/losses\": losses}, save=True)\n\nprint(\"ran code!\")"
    },
