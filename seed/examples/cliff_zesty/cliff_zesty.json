    "444d098b-16f2-4d9f-aff5-bd127a130e14": {
      "name": "fantastic_magenta",
      "code": "import numpy as np\nfrom setta.tasks.fns import SettaMemoryFn\n\nparticle_data = {}\n\n\ndef generate_particle_data(project, n_particles=1000, complexity=50):\n    positions = []\n    velocities = []\n    masses = []\n    for _ in range(n_particles):\n        pos = np.array([0.0, 0.0])\n        vel = np.array([0.0, 0.0])\n        for _ in range(complexity):\n            random_vector = np.random.randn(2)\n            pos += random_vector / np.linalg.norm(random_vector)\n            vel += np.random.randn(2) * 0.1\n        positions.append(pos)\n        velocities.append(vel)\n        masses.append(np.random.exponential(1.0))\n    particle_data[\"positions\"] = np.array(positions)\n    particle_data[\"velocities\"] = np.array(velocities)\n    particle_data[\"masses\"] = np.array(masses)\n    x = [float(pos[0]) for pos in particle_data[\"positions\"]]\n    y = [float(pos[1]) for pos in particle_data[\"positions\"]]\n    return {\n        \"particle_data\": {\n            \"name\": \"particle_data\",\n            \"type\": \"list\",\n            \"value\": {\"x\": x, \"y\": y},\n        }\n    }\n\n\ndef transform_particles(project):\n    print(\"particle_data\", particle_data, flush=True)\n    scale = float(project[\"scale\"])\n    rotation_angle = float(project[\"rotation_angle\"])\n    mass_threshold = float(project[\"mass_threshold\"])\n    cos_theta = np.cos(rotation_angle)\n    sin_theta = np.sin(rotation_angle)\n    rotation_matrix = np.array([[cos_theta, -sin_theta], [sin_theta, cos_theta]])\n    positions = particle_data[\"positions\"].copy()\n    positions = scale * (positions @ rotation_matrix.T)\n    valid_indices = particle_data[\"masses\"] >= mass_threshold\n    positions = positions[valid_indices]\n    x = [float(pos[0]) for pos in positions]\n    y = [float(pos[1]) for pos in positions]\n    return [\n        {\"name\": \"transformed_particle_data\", \"type\": \"list\", \"value\": {\"x\": x, \"y\": y}}\n    ]\n\n\nfn1 = SettaMemoryFn(fn=generate_particle_data, dependencies=[])\nfn2 = SettaMemoryFn(\n    fn=transform_particles,\n    dependencies=[\"scale\", \"rotation_angle\", \"mass_threshold\"],\n)\n"
    },
    "ca98f34c-c3f5-4c34-873c-a74eb6028e2f": {
      "name": "curly_moccasin",
      "code": "from setta.tasks.fns import SettaMemoryFn\n\n\ndef fn(project):\n    c = float(project[\"c\"])\n    n = int(project[\"n\"])\n    data = [(i, ((i - 10) / 5) ** c) for i in range(n)]\n    headers = [\"x\", \"y\"]\n    return {\n        \"simple list\": {\n            \"value\": {\"headers\": headers, \"data\": data},\n            \"type\": \"list\",\n            \"name\": \"simple list\",\n        }\n    }\n\n\ninteractive_example = SettaMemoryFn(fn=fn)\n"
    }
