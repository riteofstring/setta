region            = "us-east-1"
devbox_name       = "setta-devbox"
instance_type     = "t3a.xlarge"
root_volume_size_gb = 100

# Point this at the repo/branch you want the remote box to clone.
repo_clone_url    = "git@github.com:settadev/setta.pixijs-graph.git"
repo_checkout_path = "/home/ubuntu/dev/setta.pixijs-graph"

# Optional if you are not exporting TF_VAR_ssh_authorized_keys from the wrapper env.
# ssh_authorized_keys = [
#   "sk-ssh-ed25519@openssh.com AAAA... your-key-comment",
# ]

owner_tag  = "jeff"
cost_center = "setta-devbox"

extra_tags = {
  Purpose = "remote-dev"
}
