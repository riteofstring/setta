# Copy this file to infra/aws-devbox/aws-devbox.env for repo-local defaults used
# by ./aws.sh, ./remote.sh, and ./remote-kill.sh.

# Standard AWS CLI profile used for boto3 and Session Manager commands.
AWS_PROFILE=setta-admin

# Dedicated SSH key pair used only for SSH-over-SSM login to the devbox.
# Keep the private key on the laptop only.
# SETTA_AWS_DEVBOX_SSH_IDENTITY_FILE=$HOME/.ssh/setta-devbox-login
# SETTA_AWS_DEVBOX_SSH_PUBLIC_KEY_FILE=$HOME/.ssh/setta-devbox-login.pub

# Optional Git SSH identity to load into a local ssh-agent for forwarded remote
# git push/pull auth. This can stay Yubi-backed.
# SETTA_AWS_DEVBOX_GIT_IDENTITY_FILE=$HOME/.ssh/macgitkey

# Optional local Codex auth cache to sync to the remote box on ./remote.sh.
# OpenAI's documented headless fallback is to copy ~/.codex/auth.json to the
# remote machine. Keep this file private; it contains access tokens.
# SETTA_AWS_DEVBOX_SYNC_CODEX_AUTH=1
# SETTA_AWS_DEVBOX_CODEX_AUTH_FILE=$HOME/.codex/auth.json

# Optional explicit repo remote overrides. By default the wrappers resolve the
# local repo's `origin` URL and current branch automatically.
# SETTA_AWS_DEVBOX_REPO_REMOTE_URL=git@github.com:riteofstring/setta.git
# SETTA_AWS_DEVBOX_REPO_BRANCH=pixijs-graph

# Optional explicit overrides. Leave commented unless you need them.
# SETTA_AWS_DEVBOX_REGION=us-east-1
# SETTA_AWS_DEVBOX_TERRAFORM_DIR=/absolute/path/to/setta.pixijs-graph/infra/aws-devbox/terraform
# SETTA_AWS_DEVBOX_REPO_CHECKOUT_PATH=/home/ubuntu/dev/setta.pixijs-graph
# SETTA_AWS_DEVBOX_NAME=setta-devbox
# SETTA_AWS_DEVBOX_INSTANCE_ID=i-0123456789abcdef0
# SETTA_AWS_DEVBOX_REMOTE_START_MODE=working
# SETTA_AWS_DEVBOX_OPEN_BROWSER=1
# SETTA_AWS_DEVBOX_BROWSER_APP=Google Chrome
# SETTA_AWS_DEVBOX_BROWSER_PROFILE_DIR=$HOME/.cache/setta-aws-devbox/chrome-profile
# SETTA_AWS_DEVBOX_LOCAL_FRONTEND_PORT=3000
# SETTA_AWS_DEVBOX_SSH_USER=ubuntu
# SETTA_AWS_DEVBOX_LOCAL_SETTA_PORT=8000
# SETTA_AWS_DEVBOX_LOCAL_CDP_PORT=9222
# SETTA_AWS_DEVBOX_REMOTE_BROWSER_MODE=headless
# SETTA_AWS_DEVBOX_SSH_KNOWN_HOSTS_FILE=$HOME/.cache/setta-aws-devbox/known_hosts
# SETTA_AWS_DEVBOX_REMOTE_COMMAND=custom interactive command
# SETTA_AWS_DEVBOX_AUTO_SSO_LOGIN=0
# Include sibling repo folders in `./remote.sh` selection. Leave unset for the
# safer worktree-only default.
# SETTA_AWS_DEVBOX_INCLUDE_REPO_ENTRYPOINTS=1
# SSH-over-SSM transport tuning. Higher keepalive count tolerates longer laptop
# sleep/network blips before the local ssh client gives up. Retry limit only
# applies to the interactive attach path used by `./remote.sh`, not to explicit
# noninteractive helper calls.
# SETTA_AWS_DEVBOX_SSH_SERVER_ALIVE_INTERVAL=30
# SETTA_AWS_DEVBOX_SSH_SERVER_ALIVE_COUNT_MAX=12
# SETTA_AWS_DEVBOX_SSH_ATTACH_RETRY_LIMIT=5

# AWS-side session expiry still controls how long auth and Session Manager
# sessions can live:
# - IAM Identity Center user interactive sessions default to 8h and can be set
#   between 15 minutes and 90 days.
# - Session Manager idle timeout is configured in Session Manager preferences
#   (`idleSessionTimeout`, 1-60 minutes) and max session duration is 1-1440
#   minutes.
