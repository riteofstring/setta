            "field": "contentRef"
          }
        }
      }
    },
    {
      "id": "combine-results",
      "trigger": {
        "kind": "join",
        "mode": "all",
        "inputs": {
          "neon": {
            "bindingId": "stylize-drawing",
            "output": "image"
          },
          "riso": {
            "bindingId": "render-risograph",
            "output": "image"
          }
        }
      },
      "handler": "combine",
      "arguments": {},
      "scheduling": {
        "mode": "latest",
        "debounceMilliseconds": 0,
        "concurrencyGroup": "combine-rendering",
        "concurrencyLimit": 1
      },
      "materialization": {
        "retention": "lastSuccessful",
        "startup": "whenStale"
      },
      "outputs": {
        "image": {
          "target": {
            "sectionId": "final-result",
            "field": "contentRef"
          }
        }
      }
