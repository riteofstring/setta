{
  "$id": "https://setta.local/schemas/realtime/runtime-source-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entrypoint": {
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "projectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "source": {
      "maxLength": 1048576,
      "pattern": "^[^\\x00]*$",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "entrypoint",
    "version",
    "source"
  ],
  "title": "Setta Realtime Runtime Source V1",
  "type": "object"
}
