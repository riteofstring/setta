{
  "$defs": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "bindingId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "invocationId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "sessionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "bindingId",
        "invocationId",
        "sequence"
      ],
      "type": "object"
    },
    "invocation": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "streaming",
            "completed",
            "cancelled",
            "timedOut",
            "failed",
            "crashed",
            "superseded"
          ]
        }
      },
      "required": [
        "identity",
        "state",
        "error"
      ],
      "type": "object"
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/jsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          },
          "type": "object"
        }
      ]
    },
    "log": {
      "additionalProperties": false,
      "properties": {
        "stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "stream",
        "text"
      ],
      "type": "object"
    },
    "snapshot": {
      "additionalProperties": false,
      "properties": {
        "invocations": {
          "additionalProperties": {
            "$ref": "#/$defs/invocation"
          },
          "maxProperties": 69632,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "type": "object"
        },
        "sessionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          },
          "maxProperties": 4096,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "type": "object"
        },
        "workerState": {
          "enum": [
            "stopped",
            "starting",
            "ready",
            "failed",
            "replacing"
          ]
        }
      },
      "required": [
        "sessionId",
        "workerState",
        "values",
        "invocations"
      ],
      "type": "object"
    },
    "update": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "message": {
          "type": "string"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          },
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
            "type": "string"
          },
          "type": "object"
        },
        "progress": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "identity",
        "progress",
        "message",
        "outputs"
      ],
      "type": "object"
    }
  },
  "$id": "https://setta.local/schemas/realtime/runtime-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "type": {
          "const": "snapshot"
        }
      },
      "required": [
        "type",
        "snapshot"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "type": {
          "const": "invocation"
        }
      },
      "required": [
        "type",
        "invocation"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "update"
        },
        "update": {
          "$ref": "#/$defs/update"
        }
      },
      "required": [
        "type",
        "update"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "log": {
          "$ref": "#/$defs/log"
        },
        "type": {
          "const": "log"
        }
      },
      "required": [
        "type",
        "log"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        },
        "type": {
          "const": "error"
        }
      },
      "required": [
        "type",
        "error"
      ],
      "type": "object"
    }
  ],
  "title": "Setta Realtime Runtime V1"
}
