{
  "$defs": {
    "document": {
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "projectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "source": {
          "maxLength": 1048576,
          "pattern": "^[^\\x00]*$",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "entrypoint",
        "version",
        "source"
      ],
      "type": "object"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "type": "string"
        },
        "message": {
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "$id": "https://setta.local/schemas/realtime/apply-runtime-source-result-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "null"
            },
            "state": {
              "const": "activated"
            }
          },
          "required": [
            "state",
            "error"
          ],
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/document"
        }
      },
      "required": [
        "source",
        "activation"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "additionalProperties": false,
          "properties": {
            "error": {
              "$ref": "#/$defs/error"
            },
            "state": {
              "const": "rejected"
            }
          },
          "required": [
            "state",
            "error"
          ],
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/document"
        }
      },
      "required": [
        "source",
        "activation"
      ],
      "type": "object"
    }
  ],
  "title": "Setta Realtime Apply Runtime Source Result V1"
}
