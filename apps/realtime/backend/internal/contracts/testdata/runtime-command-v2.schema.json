{
  "$defs": {
    "identity": {
      "additionalProperties": false,
      "properties": {
        "bindingId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "invocationId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "runId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "sessionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "runId",
        "bindingId",
        "invocationId",
        "sequence"
      ],
      "type": "object"
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/jsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://setta.local/schemas/realtime/runtime-command-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cause": {
                "const": "startup"
              }
            }
          },
          "then": {
            "properties": {
              "event": {
                "enum": [
                  "change",
                  "snapshot"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "cause": {
          "enum": [
            "interaction",
            "startup"
          ]
        },
        "event": {
          "enum": [
            "change",
            "submit",
            "press",
            "snapshot"
          ]
        },
        "payload": {
          "$ref": "#/$defs/jsonValue"
        },
        "sectionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sessionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "type": {
          "const": "event"
        }
      },
      "required": [
        "type",
        "cause",
        "sessionId",
        "sectionId",
        "event",
        "payload"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "type": {
          "const": "cancel"
        }
      },
      "required": [
        "type",
        "identity"
      ],
      "type": "object"
    }
  ],
  "title": "Setta Realtime Runtime Command V2"
}
