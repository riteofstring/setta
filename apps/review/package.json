{
  "name": "@setta/review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./styles.css": "./src/index.css"
  },
  "scripts": {
    "browser:test": "node review.browser.mjs",
    "build": "pnpm --filter @riteofstring/setta run build && pnpm run contract:check && tsc --noEmit -p tsconfig.json && vite build",
    "contract:check": "go -C backend run -mod=readonly ./cmd/generate-contract -check && node scripts/compile-validators.mjs --check",
    "contract:generate": "go -C backend run -mod=readonly ./cmd/generate-contract && node scripts/compile-validators.mjs",
    "dev": "vite",
    "test": "pnpm --filter @riteofstring/setta run build && vitest run"
  },
  "dependencies": {
    "@pierre/diffs": "1.2.11",
    "@riteofstring/setta": "workspace:*",
    "ajv": "8.20.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.8",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
