{
  "$defs": {
    "artifactAnnotation": {
      "additionalProperties": false,
      "properties": {
        "artifactEvidenceId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "artifactSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/normalizedPath"
          },
          "maxItems": 512,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "artifactEvidenceId",
        "artifactSha256",
        "paths"
      ],
      "type": "object"
    },
    "assessmentProducer": {
      "additionalProperties": false,
      "properties": {
        "harness": {
          "maxLength": 1048576,
          "minLength": 1,
          "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
          "type": "string"
        },
        "model": {
          "maxLength": 1048576,
          "minLength": 1,
          "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
          "type": "string"
        }
      },
      "required": [
        "model",
        "harness"
      ],
      "type": "object"
    },
    "choiceFactor": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1048576,
          "pattern": "^[^\\x00]*$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "label": {
          "maxLength": 1048576,
          "minLength": 1,
          "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "description"
      ],
      "type": "object"
    },
    "choiceOption": {
      "additionalProperties": false,
      "properties": {
        "artifactEvidenceId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          ]
        },
        "description": {
          "maxLength": 1048576,
          "pattern": "^[^\\x00]*$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "label": {
          "maxLength": 1048576,
          "minLength": 1,
          "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "artifactEvidenceId"
      ],
      "type": "object"
    },
    "choiceRecommendation": {
      "additionalProperties": false,
      "properties": {
        "optionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1048576,
          "minLength": 1,
          "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
          "type": "string"
        }
      },
      "required": [
        "optionId",
        "rationale"
      ],
      "type": "object"
    },
    "choiceRequest": {
      "additionalProperties": false,
      "properties": {
        "expectedResponse": {
          "enum": [
            "selection",
            "ranking",
            "approval"
          ]
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/choiceFactor"
          },
          "maxItems": 32,
          "minItems": 0,
          "type": "array"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/choiceOption"
          },
          "maxItems": 64,
          "minItems": 2,
          "type": "array"
        },
        "presentation": {
          "enum": [
            "matrix",
            "artifacts"
          ]
        },
        "recommendation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/choiceRecommendation"
            }
          ]
        },
        "tradeoffs": {
          "items": {
            "$ref": "#/$defs/choiceTradeoff"
          },
          "maxItems": 2048,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "presentation",
        "expectedResponse",
        "options",
        "factors",
        "tradeoffs",
        "recommendation"
      ],
      "type": "object"
    },
    "choiceResponse": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "maxLength": 1048576,
            "minLength": 1,
            "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array"
        },
        "optionIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array"
        },
        "outcome": {
          "enum": [
            "selected",
            "ranked",
            "rejected",
            "qualified",
            "changesRequested"
          ]
        },
        "selectedArtifactEvidenceIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "optionIds",
        "conditions",
        "selectedArtifactEvidenceIds"
      ],
      "type": "object"
    },
    "choiceTradeoff": {
      "additionalProperties": false,
      "properties": {
        "factorId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "optionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "tone": {
          "enum": [
            "support",
            "risk",
            "tradeoff",
            "neutral"
          ]
        },
        "value": {
          "maxLength": 1048576,
          "minLength": 1,
          "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
          "type": "string"
        }
      },
      "required": [
        "optionId",
        "factorId",
        "value",
        "tone"
      ],
      "type": "object"
    },
    "completionClaim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "text": {
          "maxLength": 1048576,
          "minLength": 1,
          "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object"
    },
    "completionDecision": {
      "additionalProperties": false,
      "properties": {
        "claimId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accepted",
            "qualified",
            "rejected",
            "needsEvidence"
          ]
        },
        "qualification": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 1048576,
              "minLength": 1,
              "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
              "type": "string"
            }
          ]
        },
        "rationale": {
          "maxLength": 1048576,
          "pattern": "^[^\\x00]*$",
          "type": "string"
        }
      },
      "required": [
        "claimId",
        "decision",
        "rationale",
        "qualification"
      ],
      "type": "object"
    },
    "completionRequest": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/completionClaim"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "claims"
      ],
      "type": "object"
    },
    "completionResponse": {
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "items": {
            "$ref": "#/$defs/completionDecision"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "decisions"
      ],
      "type": "object"
    },
    "continuationPacket": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/resolvedEvidence"
          },
          "maxItems": 512,
          "minItems": 0,
          "type": "array"
        },
        "projectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/reviewRequest"
        },
        "requestSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "response": {
          "$ref": "#/$defs/reviewResponse"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "version",
        "projectId",
        "request",
        "requestSha256",
        "response",
        "evidence"
      ],
      "type": "object"
    },
    "deleteResponseOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteResponse"
        },
        "requestId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "op",
        "requestId"
      ],
      "type": "object"
    },
    "evidenceCitation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "endLine": {
              "minimum": 1,
              "type": "integer"
            },
            "kind": {
              "const": "lineRange"
            },
            "startLine": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "startLine",
            "endLine"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "jsonPointer"
            },
            "pointer": {
              "maxLength": 1024,
              "pattern": "^(|/(?:[^~]|~[01])*)$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "pointer"
          ],
          "type": "object"
        }
      ]
    },
    "evidenceReference": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "gitDiff": {
              "additionalProperties": false,
              "properties": {
                "baseRevision": {
                  "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
                  "type": "string"
                },
                "contextLines": {
                  "maximum": 20,
                  "minimum": 0,
                  "type": "integer"
                },
                "hunk": {
                  "$ref": "#/$defs/gitHunk"
                },
                "path": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$))[^\\\\\\x00]+$",
                  "type": "string"
                },
                "repositoryPath": {
                  "anyOf": [
                    {
                      "const": "."
                    },
                    {
                      "maxLength": 1024,
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$))[^\\\\\\x00]+$",
                      "type": "string"
                    }
                  ]
                },
                "targetRevision": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "repositoryPath",
                "baseRevision",
                "targetRevision",
                "path",
                "contextLines",
                "hunk"
              ],
              "type": "object"
            },
            "id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "kind": {
              "const": "gitDiff"
            }
          },
          "required": [
            "id",
            "kind",
            "gitDiff"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "kind": {
              "const": "text"
            },
            "text": {
              "additionalProperties": false,
              "properties": {
                "endLine": {
                  "minimum": 1,
                  "type": "integer"
                },
                "mediaType": {
                  "pattern": "^text/[a-z0-9][a-z0-9!#$\u0026^_.+-]{0,126}$",
                  "type": "string"
                },
                "path": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$))[^\\\\\\x00]+$",
                  "type": "string"
                },
                "startLine": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "path",
                "mediaType",
                "startLine",
                "endLine"
              ],
              "type": "object"
            }
          },
          "required": [
            "id",
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "json": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$))[^\\\\\\x00]+$",
                  "type": "string"
                },
                "pointers": {
                  "items": {
                    "maxLength": 1024,
                    "pattern": "^(|/(?:[^~]|~[01])*)$",
                    "type": "string"
                  },
                  "maxItems": 64,
                  "minItems": 0,
                  "type": "array"
                }
              },
              "required": [
                "path",
                "pointers"
              ],
              "type": "object"
            },
            "kind": {
              "const": "json"
            }
          },
          "required": [
            "id",
            "kind",
            "json"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "additionalProperties": false,
              "properties": {
                "byteLength": {
                  "minimum": 0,
                  "type": "integer"
                },
                "mediaType": {
                  "pattern": "^[a-z0-9][a-z0-9!#$\u0026^_.+-]{0,126}/[a-z0-9][a-z0-9!#$\u0026^_.+-]{0,126}$",
                  "type": "string"
                },
                "path": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$))[^\\\\\\x00]+$",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "mediaType",
                "byteLength",
                "sha256"
              ],
              "type": "object"
            },
            "id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "kind": {
              "const": "artifact"
            }
          },
          "required": [
            "id",
            "kind",
            "artifact"
          ],
          "type": "object"
        }
      ]
    },
    "evidenceRelation": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/evidenceCitation"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array"
        },
        "evidenceId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "role": {
          "enum": [
            "supports",
            "challenges",
            "qualifies",
            "informs"
          ]
        },
        "subjectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "subjectKind": {
          "enum": [
            "claim",
            "option",
            "factor"
          ]
        }
      },
      "required": [
        "id",
        "subjectKind",
        "subjectId",
        "evidenceId",
        "role",
        "citations"
      ],
      "type": "object"
    },
    "exportDocument": {
      "additionalProperties": false,
      "properties": {
        "continuations": {
          "items": {
            "$ref": "#/$defs/continuationPacket"
          },
          "maxItems": 128,
          "minItems": 0,
          "type": "array"
        },
        "projectId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "responses": {
          "items": {
            "$ref": "#/$defs/reviewResponse"
          },
          "maxItems": 128,
          "minItems": 0,
          "type": "array"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "version",
        "projectId",
        "revision",
        "responses",
        "continuations"
      ],
      "type": "object"
    },
    "exportResult": {
      "additionalProperties": false,
      "properties": {
        "export": {
          "$ref": "#/$defs/exportDocument"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "version",
        "export"
      ],
      "type": "object"
    },
    "externalAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "enum": [
            "supported",
            "contradicted",
            "unproven",
            "qualified"
          ]
        },
        "caveat": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 1048576,
              "minLength": 1,
              "pattern": "^(\\S|\\S[\\s\\S]*\\S)$",
              "type": "string"
            }
          ]
        },
        "claimId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "createdAt": {
          "maxLength": 1048576,
          "pattern": "^[^\\x00]*$",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/assessmentProducer"
        },
        "rationale": {
          "maxLength": 1048576,
          "pattern": "^[^\\x00]*$",
          "type": "string"
        },
        "requestId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "version",
        "id",
        "requestId",
        "claimId",
        "assessment",
        "rationale",
        "caveat",
        "producer",
        "createdAt"
      ],
      "type": "object"
    },
    "gitHunk": {
      "additionalProperties": false,
      "properties": {
        "newLines": {
          "minimum": 0,
          "type": "integer"
        },
        "newStart": {
          "minimum": 0,
          "type": "integer"
        },
        "oldLines": {
          "minimum": 0,
          "type": "integer"
        },
        "oldStart": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "oldStart",
        "oldLines",
        "newStart",
        "newLines"
      ],
      "type": "object"
    },
    "importAssessmentOperation": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "$ref": "#/$defs/externalAssessment"
        },
        "op": {
          "const": "importAssessment"
        }
      },
      "required": [
        "op",
        "assessment"
      ],
      "type": "object"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "maxLength": 1048576,
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/jsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          },
          "type": "object"
        }
      ]
    },
    "mutationResult": {
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/reviewSnapshot"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "version",
        "snapshot"
      ],
      "type": "object"
    },
    "normalizedPath": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/normalizedPoint"
          },
          "maxItems": 8192,
          "minItems": 2,
          "type": "array"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 0.1,
          "type": "number"
        }
      },
      "required": [
        "color",
        "width",
        "points"
      ],
      "type": "object"
    },
    "normalizedPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
