{
  "name": "@setta/python-canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./project-snapshot-v2.json": "./backend/internal/contracts/testdata/project-snapshot-v2.json",
    "./styles.css": "./src/index.css"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "browser:test": "node vertical-slice.browser.mjs",
    "dev": "vite",
    "test": "pnpm --filter @setta/workspace run build && vitest run && node --test browser-processes.test.mjs param-dict-list.browser-selectors.test.mjs",
    "contract:generate": "go -C backend run ./cmd/generate-contract",
    "contract:check": "go -C backend run ./cmd/generate-contract -check"
  },
  "dependencies": {
    "@setta/workspace": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "basedpyright": "1.39.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.8",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
