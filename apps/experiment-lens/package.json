{
  "name": "@setta/experiment-lens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "browser:test": "node experiment-lens.browser.mjs",
    "build": "pnpm --filter @setta/workspace run build && pnpm run contract:check && tsc --noEmit -p tsconfig.json && vite build",
    "contract:check": "go -C backend run -mod=readonly ./cmd/generate-contract -check && node scripts/compile-validators.mjs --check",
    "contract:generate": "go -C backend run -mod=readonly ./cmd/generate-contract && node scripts/compile-validators.mjs",
    "dev": "vite",
    "fixture:generate": "node examples/battery-playground/generate-fixture.mjs",
    "test": "pnpm --filter @setta/workspace run build && vitest run"
  },
  "dependencies": {
    "@setta/workspace": "workspace:*",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "ajv": "8.20.0",
    "echarts": "6.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.8",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
